{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aico/fleet-frames",
  "title": "Fleet link frames v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "hello"
        },
        "version": {
          "const": 1
        },
        "machine": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "publicKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["type", "version", "machine", "publicKey"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "auth"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": ["type", "signature"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["control", "event", "sync", "terminal-view"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,80}$"
        },
        "op": {
          "const": "open"
        },
        "target": {
          "enum": ["control", "sync", "exec", "jobs"]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          }
        }
      },
      "required": ["type", "id", "op", "target"],
      "oneOf": [
        {
          "properties": {
            "target": {
              "const": "exec"
            }
          },
          "required": ["argv"]
        },
        {
          "properties": {
            "target": {
              "enum": ["control", "sync", "jobs"]
            }
          },
          "not": {
            "required": ["argv"]
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["control", "event", "sync", "terminal-view"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,80}$"
        },
        "op": {
          "const": "data"
        },
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": ["type", "id", "op", "data"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["control", "event", "sync", "terminal-view"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,80}$"
        },
        "op": {
          "const": "end"
        }
      },
      "required": ["type", "id", "op"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["control", "event", "sync", "terminal-view"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,80}$"
        },
        "op": {
          "const": "close"
        }
      },
      "required": ["type", "id", "op"]
    }
  ]
}
