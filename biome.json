{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "."
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "electron/**",
      "extension/**/*.js",
      "web/**/*.js",
      "scripts/**/*.{js,mjs}",
      "vitest.config.ts",
      "electron.vite.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["electron/renderer/arcade/concepts/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "noThenProperty": "off",
            "useIterableCallbackReturn": "off",
            "noFallthroughSwitchClause": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off"
          },
          "complexity": {
            "useOptionalChain": "off",
            "noUselessLoneBlockStatements": "off",
            "noCommaOperator": "off"
          },
          "style": {
            "useConst": "off",
            "useTemplate": "off",
            "useExponentiationOperator": "off"
          }
        }
      }
    }
  ]
}
