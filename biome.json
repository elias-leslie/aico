{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "."
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "electron/**",
      "shared/**",
      "scripts/**/*.{js,mjs}",
      "vitest.config.ts",
      "electron.vite.config.ts",
      "tether/**",
      "web/server/**",
      "web/frontend/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["electron/renderer/arcade/concepts/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "noThenProperty": "off",
            "useIterableCallbackReturn": "off",
            "noFallthroughSwitchClause": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off"
          },
          "complexity": {
            "useOptionalChain": "off",
            "noUselessLoneBlockStatements": "off",
            "noCommaOperator": "off"
          },
          "style": {
            "useConst": "off",
            "useTemplate": "off",
            "useExponentiationOperator": "off"
          }
        }
      }
    }
  ]
}
