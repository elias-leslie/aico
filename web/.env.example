# Web server settings (aico-web.service). Copy what you need to
# ~/.config/credstore/a-term/env (mode 0600); the unit reads that file. There is
# no database server: sessions live in Tether and the web app's tabs and
# project settings in ~/.local/state/aico/web.db.

# Tether control socket. Defaults to $XDG_RUNTIME_DIR/tether/default/control.sock.
# Agent shares are accepted only from that default socket.
# TETHER_SOCKET=/run/user/1000/tether/default/control.sock

# Listener: loopback only. The port defaults to runtime.backend_port in
# project.identity.json (3002).
# AICO_WEB_HOST=127.0.0.1
# AICO_WEB_PORT=3002

# Browser origins trusted for the terminal WebSocket and writes (comma-separated).
# The default is loopback on the port plus https://<hosts.browser_frontend>.
# AICO_WEB_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Optional Agent Hub (voice and clean prompt)
# AGENT_HUB_URL=http://127.0.0.1:8003
# The client id Agent Hub registered for the web app; clean prompt needs it.
# AGENT_HUB_CLIENT_ID=

# Uploads
MAX_FILE_SIZE_MB=10
# Defaults to ~/aico-uploads. Uncomment to override it.
# UPLOAD_DIR=/home/YOUR_USER/aico-uploads
UPLOAD_MAX_AGE_SECONDS=86400

# Maintenance: upload cleanup and deleting tabs that show no session
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=900
MAINTENANCE_SESSION_PURGE_DAYS=7
