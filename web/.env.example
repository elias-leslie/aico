# Web app settings. Copy what you need to ~/.config/credstore/a-term/env (mode 0600);
# the backend also reads ~/.env.local. The web app keeps no database server: sessions live in the Tether daemon and
# view state (panes, layouts, project display settings) lives in a local
# SQLite file under ~/.local/state/a-term/.

# Tether control socket. Defaults to $XDG_RUNTIME_DIR/tether/default/control.sock.
# TETHER_SOCKET=/run/user/1000/tether/default/control.sock

# Service
A_TERM_PORT=8002
A_TERM_BIND_HOST=127.0.0.1
A_TERM_FRONTEND_PORT=3002
A_TERM_FRONTEND_HOST=127.0.0.1
LOG_LEVEL=INFO
LOG_DIR=logs

# Optional companion services (uncomment when companion integrations are enabled)
# NEXT_PUBLIC_AGENT_HUB_URL=http://127.0.0.1:8003
# AGENT_HUB_URL=http://127.0.0.1:8003
# The client id Agent Hub registered for the web app; clean prompt needs it.
# AGENT_HUB_CLIENT_ID=

# Browser origins the web app trusts for CORS, the terminal WebSocket and writes (JSON array). The default is the local
# frontend plus project.identity.json hosts.browser_frontend; set this only to replace that list.
# A_TERM_ALLOWED_ORIGINS=["http://localhost:3002","http://127.0.0.1:3002"]

# Public auth
# Keep A_TERM_AUTH_MODE=none only for loopback-only development.
A_TERM_AUTH_MODE=none
# Required when A_TERM_AUTH_MODE=password
A_TERM_AUTH_PASSWORD=
# Required when A_TERM_AUTH_MODE=password or proxy
A_TERM_AUTH_SECRET=
A_TERM_AUTH_PROXY_HEADER=X-Forwarded-User
A_TERM_AUTH_COOKIE_SECURE=false
A_TERM_AUTH_SESSION_TTL_HOURS=168

# Uploads
MAX_FILE_SIZE_MB=10
# Defaults to ~/a-term-uploads. Uncomment to override it.
# UPLOAD_DIR=/home/YOUR_USER/a-term-uploads
UPLOAD_MAX_AGE_SECONDS=86400

# Maintenance
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=900
MAINTENANCE_SESSION_PURGE_DAYS=7
