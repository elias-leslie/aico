{
  "about": "Limits for agents that can't be trusted unwatched (today: Antigravity sessions, through `aico-hook agy`). Checked in code on every tool call, before the agent's own permission rules. A refusal tells the agent why and what to do instead. Stops a dumb agent, not a hostile one: a script the agent runs is read when it is a plain file, but what a program does at run time isn't seen.",
  "refusal": "Refused by Aico's limits for this agent: {why} Don't try another way around it. If the task needs this, say so in your report, or ask with: tether ask create \"<one line that stands alone>\" --option A --option B --recommend 1",
  "allowed_tools": ["finish", "run_command", "read_file", "write_file", "edit_file", "search_web", "manage_task", "invoke_subagent", "manage_subagents", "define_subagent", "send_message"],
  "tool_refused": "the tool {tool} is off for this agent.",
  "ask_tool": "ask_question",
  "ask_refused": "questions to the owner go through tether ask, not {tool}.",
  "path_refused": "that path is out of bounds ({why}).",
  "outside_refused": "it changes something outside this project and /tmp ({path}).",
  "unknown_target_refused": "it changes a path that can't be worked out ahead of time ({path}); name it plainly.",
  "root_refused": "it would delete the project itself or its git history ({path}).",
  "write_extra_roots": ["/tmp"],
  "null_targets": ["/dev/null", "/dev/stdout", "/dev/stderr", "/dev/tty"],
  "denied_paths": [
    {"path": "~/.ssh", "why": "keys"},
    {"path": "~/.aws", "why": "keys"},
    {"path": "~/.netrc", "why": "keys"},
    {"path": "~/.gnupg", "why": "keys"},
    {"path": "~/.kube", "why": "keys"},
    {"path": "~/.npmrc", "why": "keys"},
    {"path": "~/.docker", "why": "keys"},
    {"path": "~/.smbcredentials", "why": "keys"},
    {"path": "~/.config/rclone", "why": "keys"},
    {"path": "~/.config/gh", "why": "keys"},
    {"path": "~/.codex/auth.json", "why": "a login"},
    {"path": "~/.claude/.credentials.json", "why": "a login"},
    {"path": "~/.pi/agent/auth.json", "why": "a login"},
    {"path": "~/.gemini/oauth_creds.json", "why": "a login"},
    {"path": "~/.gemini/google_accounts.json", "why": "a login"},
    {"path": "~/.gemini/antigravity-cli/antigravity-oauth-token", "why": "a login"},
    {"path": "~/.gemini/config", "why": "this agent's own limits"},
    {"path": "~/.gemini/settings.json", "why": "this agent's own limits"},
    {"path": "~/.gemini/antigravity-cli/settings.json", "why": "this agent's own limits"},
    {"path": "~/.local/lib/aico", "why": "this agent's own limits"},
    {"path": "~/.local/bin/aico-hook", "why": "this agent's own limits"},
    {"path": "~/.config/tether", "why": "session control"},
    {"path": "~/.local/state/tether", "why": "session control"},
    {"path": "~/.local/state/aico", "why": "Aico's live data"},
    {"path": "~/.local/share/aico", "why": "Aico's live data"},
    {"path": "/run/user", "why": "session control sockets"},
    {"path": "/mnt", "why": "backups and storage"},
    {"path": "/srv/workspaces/projects/neri-hunters", "why": "hunter data stays closed"}
  ],
  "denied_text": [
    {"pattern": "(^|[\\s/'\"=<(])\\.env(\\.(local|prod|production|dev|development|staging|bak|backup)[\\w.-]*)?($|[\\s'\";|&)*])", "why": ".env files hold credentials."},
    {"pattern": "control\\.sock|--unix-socket", "why": "it talks straight to a control socket."}
  ],
  "denied_code": [
    {"pattern": "\\bos\\.(kill|killpg|remove|unlink|rmdir)\\s*\\(|\\bshutil\\.rmtree\\b|\\bprocess\\.kill\\s*\\(|\\bfs\\.(rm|rmSync|unlink|unlinkSync|rmdir|rmdirSync)\\s*\\(", "why": "a script here kills processes or deletes files; use plain shell commands so they can be checked."}
  ],
  "message_commands": [["st", "commit"], ["tether", "ask"]],
  "option_targets": {
    "tar": ["-C", "--directory"],
    "curl": ["-o", "--output"],
    "wget": ["-O", "--output-document", "-P", "--directory-prefix"],
    "unzip": ["-d"]
  },
  "script_runners": ["bash", "sh", "zsh", "python", "python3", "node", "tsx", "perl", "ruby"],
  "script_read_bytes": 262144,
  "value_options": {
    "git": ["-C", "-c", "--git-dir", "--work-tree"],
    "st": ["-P"],
    "tether": ["--instance"]
  },
  "allowed_commands": [
    ["tether", "ask"],
    ["tether", "share"],
    ["tether", "version"],
    ["st", "aico", "wait"]
  ],
