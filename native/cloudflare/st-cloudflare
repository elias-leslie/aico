#!/usr/bin/env bash
# st cloudflare: on-demand client for Cloudflare's official MCP server. Costs nothing until run.
# The OAuth grant lives in the Aico login `cloudflare-mcp-oauth`; it is injected into this
# one process and never printed. `login` and `finish` run without it.
set -euo pipefail
root="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
node="${AICO_NODE:-/usr/local/bin/node}"
[ -x "$node" ] || node="$(command -v node)"
aico="${AICO_BIN:-aico}"
case "${1:-}" in
  login | finish | help | --help | -h | "") exec "$node" --disable-warning=ExperimentalWarning "$root/cloudflare.mjs" "$@" ;;
esac
if "$aico" logins show cloudflare-mcp-oauth >/dev/null 2>&1; then
  exec "$aico" logins run --with cloudflare-mcp-oauth=CLOUDFLARE_MCP_OAUTH -- \
    "$node" --disable-warning=ExperimentalWarning "$root/cloudflare.mjs" "$@"
fi
exec "$node" --disable-warning=ExperimentalWarning "$root/cloudflare.mjs" "$@"
