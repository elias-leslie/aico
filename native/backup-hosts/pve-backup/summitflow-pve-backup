#!/usr/bin/python3 -I
"""Forced command for SummitFlow's Proxmox backup key on davion-gem.

Installed as /usr/local/sbin/summitflow-pve-backup by scripts/pve-backup/install.sh and
bound to one key in /root/.ssh/authorized_keys with restrict,command="...". The key
sends one fixed verb; no shell ever runs what it sends:

  guests                  guest list (pvesh get /cluster/resources --type vm)
  host-boot               kernel boot identity (to recognize a host restart during a copy)
  thinpool                data_percent of the guest thin pool
  sources                 the installed source list (install.sh shows what a re-install changes)
  capture SOURCE DIGEST   stream one registered source to stdout (a stopped VM or container is read from a
                          read-only thin snapshot of its disk, not through the guest agent or pct exec)

What a source captures comes only from /etc/summitflow-pve-backup/sources.json, which
root installs from SummitFlow's registered sources. DIGEST is the SHA-256 of the source
path as SummitFlow has it now; a mismatch means the source changed on the workstation,
and it is refused until root re-runs install.sh.

The cluster config dump leaves out priv/ and every *.key file (authkey.key, pve-www.key,
pve-root-ca.key, node ssl keys; PVE regenerates them on restore). The source list is
built from sources agents can register, so this side keeps its own floor: a host path
must be one of HOST_PATHS exactly (adding one takes a dispatcher release), and is still
refused when it is a *.key file or, as written or as resolved here, holds or sits under
PVE's or root's secrets (config.db, /etc/pve priv directories, /root, /etc/ssh,
/etc/corosync). Host tars always exclude those secrets as well, and the
OmniNull hub (CT 150) and append-only restic (CT 160) are never captured.
"""

import fcntl
from contextlib import contextmanager
import fnmatch
import json
import os
import re
import secrets
import signal
import shlex
import sqlite3
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SOURCES = Path("/etc/summitflow-pve-backup/sources.json")
BOOT_ID = Path("/proc/sys/kernel/random/boot_id")
CAPTURE_LOCKS = Path("/run/lock/summitflow-pve-backup")
CONFIG_DATABASE = "/var/lib/pve-cluster/config.db"
DUMP_DIRECTORY = Path("/var/lib/vz/dump")
DUMP_LOG_KEEP_DAYS = 7
THIN_POOL = "pve/data"
GUARD = "/usr/local/sbin/aico-backup-guard"
GUARD_STATUS = Path("/run/aico-backup-guard/status.json")
DISPATCHER = str(Path(__file__).resolve())
GUEST_LOCK = "/run/lock/aico-backup-export.lock"
MOUNT_PARENT = "/run"  # Where a stopped VM's disk snapshot is mounted, read-only, for one capture.
# The only host files and directories a source may read: exactly what pve-host-files captures.
HOST_PATHS = frozenset({"/vault/identity", "/vault/meta/recovery-key.json", "/etc/pve/qemu-server/120.conf",
                        "/var/lib/vz/snippets/neri-120-init.yaml", "/var/lib/vz/snippets/neri-120-meta.yaml"})
# Never read on the host, nor any directory holding them; '*' is one path component. /etc/pve/local links to nodes/<node>.
PROTECTED_PATHS = ("root", "var/lib/pve-cluster", "etc/pve/priv", "etc/pve/nodes/*/priv", "etc/pve/local/priv",
                   "etc/ssh", "etc/corosync")
# Excluded from every host tar, case-insensitively ('*' matches across '/' here, as in tar).
PVE_SECRETS = ("etc/pve/priv", "etc/pve/*/priv", "etc/pve/*.key", "var/lib/pve-cluster", "root/.ssh", "etc/ssh/ssh_host_*",
               "etc/corosync/authkey")
PROTECTED_GUESTS = frozenset({150, 160})  # OmniNull hub and response authority; append-only restic.
_SOURCE_ID = re.compile(r"[A-Za-z0-9._-]{1,128}")
_DIGEST = re.compile(r"[0-9a-f]{64}")
_PATH = re.compile(r"/(?:[A-Za-z0-9._@+-][A-Za-z0-9 ._@+-]*/?)+")
_EXCLUDE = re.compile(r"[A-Za-z0-9 ._*@+/-]{1,128}")
_VIA = {"host": "host", "lxc": "pct", "qemu": "agent"}


class Refused(Exception):
    pass


class Deferred(Refused):
    pass


def protected_host_path(path):
    """True for /, a *.key file, or a path that holds or sits under a protected one, as written or as resolved here."""
    for candidate in {path, os.path.realpath(path)}:
        parts = [part for part in candidate.split("/") if part]
        if not parts or parts[-1].lower().endswith(".key"):
            return True
        for protected in PROTECTED_PATHS:
            pattern = protected.split("/")
            if all(fnmatch.fnmatchcase(part, want) for part, want in zip(parts, pattern)):
                return True
    return False


def allowed_host_path(path):
    """True only for one of HOST_PATHS (tar never follows a symlink inside /vault/identity)."""
    return os.path.normpath(path) in HOST_PATHS


def load_source(source_id, digest):
    """The installed definition of one source, checked again here (root wrote it, agents may have shaped it)."""
    if not _SOURCE_ID.fullmatch(source_id) or not _DIGEST.fullmatch(digest):
        raise Refused("capture needs a source id and the SHA-256 of its path")
    entry = json.loads(SOURCES.read_text()).get(source_id)
    if not isinstance(entry, dict):
        raise Refused(f"{source_id} is not installed on this host; run scripts/pve-backup/install.sh")
    if entry.get("digest") != digest:
        raise Refused(f"{source_id} changed on the workstation; run scripts/pve-backup/install.sh")
    kind, vmid, files = entry.get("kind"), entry.get("vmid"), entry.get("files")
    if kind == "config":
        if vmid is not None or files is not None:
            raise Refused(f"{source_id}: malformed config entry")
        return entry
    if kind == "host" and (vmid is not None or files is None):
        raise Refused(f"{source_id}: host entries name files only")
    if kind in {"qemu", "lxc"} and not (isinstance(vmid, int) and not isinstance(vmid, bool) and 0 < vmid < 10**9):
        raise Refused(f"{source_id}: malformed guest id")
    if kind not in _VIA:
        raise Refused(f"{source_id}: unknown kind")
    if vmid in PROTECTED_GUESTS:
        raise Refused(f"{source_id}: guest {vmid} is never captured by this key")
    if files is not None:
        paths, excludes = files.get("paths"), files.get("excludes")
        if files.get("via") != _VIA[kind] or not isinstance(paths, list) or not paths or not isinstance(excludes, list):
            raise Refused(f"{source_id}: malformed file selection")
        if any(not isinstance(path, str) or not _PATH.fullmatch(path) or ".." in path.split("/") for path in paths):
            raise Refused(f"{source_id}: unsafe path")
        if any(not isinstance(item, str) or not _EXCLUDE.fullmatch(item) for item in excludes):
            raise Refused(f"{source_id}: unsafe exclude")
        if kind == "host" and any(protected_host_path(path) for path in paths):
            raise Refused(f"{source_id}: a host path holds PVE or root secrets")
        if kind == "host" and not all(allowed_host_path(path) for path in paths):
            raise Refused(f"{source_id}: host paths must be one of {', '.join(sorted(HOST_PATHS))}; another needs a dispatcher release")
    return entry


def config_dump(out):
    """SQL dump of the cluster database without any priv/ directory (top level and per node) or *.key file."""
    source = sqlite3.connect(f"file:{CONFIG_DATABASE}?mode=ro", uri=True)
    memory = sqlite3.connect(":memory:")
    try:
        source.backup(memory)
    finally:
        source.close()
    memory.execute(
        "WITH RECURSIVE hidden(inode) AS ("
        " SELECT inode FROM tree WHERE name = 'priv'"
        " UNION SELECT tree.inode FROM tree JOIN hidden ON tree.parent = hidden.inode AND tree.inode != hidden.inode)"
        " DELETE FROM tree WHERE inode IN hidden OR name LIKE '%.key'"
    )
    for line in memory.iterdump():
        out.write(line.encode() + b"\n")
    out.flush()
    return 0


def tar_command(files, *, host=False, root="/"):
    """A tar stream of the selected paths; exit 1 (a file changed while read) is accepted by the caller."""
    floor = ["--ignore-case", *[f"--exclude={item}" for item in PVE_SECRETS], "--no-ignore-case"] if host else []
    return ["tar", "--create", "--file=-", "--one-file-system", "--ignore-failed-read", "--warning=no-file-changed",
            "--warning=no-file-removed", *floor, *[f"--exclude={item}" for item in files["excludes"]], "-C", root, "--",
            *[path.strip("/") for path in files["paths"]]]


def _tar_ok(code):
    return 0 if code <= 1 else code


def vzdump(kind, vmid, run=subprocess.run):
    """The whole guest on stdout; snapshot mode never stops it. vzdump still writes a small log: keep a week."""
    code = run(["vzdump", str(vmid), "--stdout", "1", "--mode", "snapshot", "--compress", "0", "--quiet", "1"]).returncode
    cutoff = time.time() - DUMP_LOG_KEEP_DAYS * 86400
    for log in DUMP_DIRECTORY.glob(f"vzdump-{kind}-{vmid}-*.log"):
        try:
            if log.is_file() and not log.is_symlink() and log.stat().st_mtime < cutoff:
                log.unlink()
        except OSError:
            pass  # Diagnostics housekeeping never fails a completed capture.
    return code


def _guest_of(vmid, run=subprocess.run, kind="qemu"):
    listing = run(["pvesh", "get", "/cluster/resources", "--type", "vm", "--output-format", "json"],
                  capture_output=True, text=True, check=True)
    for item in json.loads(listing.stdout):
        if item.get("vmid") == vmid and item.get("type") == kind:
            return item
    raise Refused(f"{kind} {vmid} does not exist")


def _boot_volume(node, vmid, run, kind="qemu"):
    """The guest's root disk as a device path: a VM's first of boot order, scsi0, virtio0, sata0, ide0; a container's rootfs."""
    config = json.loads(run(["pvesh", "get", f"/nodes/{node}/{kind}/{vmid}/config", "--output-format", "json"],
                            capture_output=True, text=True, check=True).stdout)
    if config.get("lock"):
        raise Deferred(f"{kind} {vmid} has a Proxmox operation in progress")
    order = re.search(r"order=([^;]*)", str(config.get("boot", "")))
    keys = ["rootfs"] if kind == "lxc" else (order.group(1).split(";") if order else []) + ["scsi0", "virtio0", "sata0", "ide0"]
    for key in keys:
        match = re.fullmatch(rf"([A-Za-z0-9_-]+):(vm-{vmid}-disk-[0-9]+)(?:,.*)?", str(config.get(key, "")))
        if match:
            path = run(["pvesm", "path", f"{match.group(1)}:{match.group(2)}"], capture_output=True, text=True,
                       check=True).stdout.strip()
            if re.fullmatch(rf"/dev/[A-Za-z0-9_+.-]+/vm-{vmid}-disk-[0-9]+", path):
                return path
    raise Refused(f"qemu {vmid} has no boot disk on thin LVM")


def _root_partition(device, run):
    """The largest ext4, xfs or btrfs partition of a loop device (a cloud image's root; the others are boot and EFI)."""
    listing = json.loads(run(["lsblk", "--json", "--bytes", "-o", "PATH,SIZE,FSTYPE,TYPE", device],
                             capture_output=True, text=True, check=True).stdout)
    # lsblk lists the partitions as siblings of the loop device, or under it, depending on its version.
    found, queue = [], list(listing["blockdevices"])
    while queue:
        item = queue.pop()
        found.append(item)
        queue.extend(item.get("children", []))
    parts = [child for child in found if child.get("type") == "part" and child.get("fstype") in {"ext4", "xfs", "btrfs"}]
    if not parts:
        raise Refused("the stopped VM's disk has no readable root filesystem")
    best = max(parts, key=lambda child: int(child["size"]))
    return best["path"], best["fstype"]


def frozen_snapshot(vmid, create, run):
    """Freeze only while creating the thin snapshot; confirm thaw before any mount or stream."""
    def command(verb):
        return run(["qm", "guest", "cmd", str(vmid), "fsfreeze-" + verb], capture_output=True, text=True)

    before = command("status")
    if before.returncode or before.stdout.strip() != "thawed":
        raise Refused(f"qemu {vmid} is not confirmed thawed; no snapshot was taken")
    # Freeze can partially succeed before qm reports failure. Always thaw after attempting it.
    try:
        frozen = command("freeze")
        if frozen.returncode:
            raise Refused(f"qemu {vmid} could not freeze its filesystem")
        status = command("status")
        if status.returncode or status.stdout.strip() != "frozen":
            raise Refused(f"qemu {vmid} did not confirm its frozen filesystem")
        create()
    finally:
        command("thaw")
        after = command("status")
        if after.returncode or after.stdout.strip() != "thawed":
            raise Refused(f"qemu {vmid} could not confirm its filesystem thawed; no files were streamed")


@contextmanager
def capture_signals():
    """A normal stop/disconnect unwinds snapshot and thaw cleanup; repeated signals do not cut cleanup short."""
    interrupted = False

    def stop(signum, _frame):
        nonlocal interrupted
        if not interrupted:
            interrupted = True
            raise Refused(f"capture interrupted by {signal.Signals(signum).name}")

    previous = {number: signal.signal(number, stop) for number in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
    try:
        yield
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


def disk_files(vmid, files, out, node, run=subprocess.run, kind="qemu", running=False):
    """Tar selected files from a read-only thin snapshot; a running VM is briefly frozen while it is created.

    A container's disk is one filesystem and is mounted as it is (no loop device); its owner ids are the host's mapped ids.

    The snapshot is point-in-time, so a VM that starts meanwhile cannot change what is read. Paths are checked after the
    mount: one that resolves outside the mounted filesystem (an absolute symlink) is refused, never followed on the host.
    """
    device = _boot_volume(node, vmid, run, kind)
    group, volume = device.split("/")[2:4]
    snapshot_name = f"st-backup-{vmid}"
    snapshot = f"{group}/{snapshot_name}"
    loop = mount = None
    mounted = False

    def quiet(argv):
        run(argv, capture_output=True, text=True)

    def release():
        if mounted:
            quiet(["umount", str(mount)])
        if mount:
            try:
                mount.rmdir()
            except OSError:
                pass
        if loop:
            quiet(["losetup", "-d", loop])
        quiet(["lvremove", "-f", snapshot])

    # A snapshot left by a killed run: detach its loop devices first, then drop the volume.
    for stale in run(["losetup", "-j", f"/dev/{snapshot}"], capture_output=True, text=True).stdout.splitlines():
        quiet(["losetup", "-d", stale.split(":")[0]])
    quiet(["lvremove", "-f", snapshot])
    try:
        def create():
            run(["lvcreate", "--snapshot", "--name", snapshot_name, "--setactivationskip", "n", "--quiet", f"{group}/{volume}"],
                capture_output=True, text=True, check=True)

        if running:
            frozen_snapshot(vmid, create, run)
        else:
            create()
        if kind == "lxc":
            partition = f"/dev/{snapshot}"
            fstype = run(["blkid", "-o", "value", "-s", "TYPE", partition], capture_output=True, text=True,
                         check=True).stdout.strip()
            if fstype not in {"ext4", "xfs", "btrfs"}:
                raise Refused("the stopped container's disk has no readable root filesystem")
        else:
            loop = run(["losetup", "--find", "--show", "--read-only", "--partscan", f"/dev/{snapshot}"],
                       capture_output=True, text=True, check=True).stdout.strip()
            run(["udevadm", "settle", "--timeout=30"], capture_output=True, text=True)
            partition, fstype = _root_partition(loop, run)
        mount = Path(tempfile.mkdtemp(prefix=f"st-backup-{vmid}-", dir=MOUNT_PARENT))
        options = "ro,nodev,nosuid,noexec" + (",norecovery" if fstype in {"ext4", "xfs"} else "")
        run(["mount", "-t", fstype, "-o", options, partition, str(mount)], capture_output=True, text=True, check=True)
        mounted = True
        root = os.path.realpath(mount)
        for path in files["paths"]:
            resolved = os.path.realpath(mount / path.strip("/"))
            if resolved != root and not resolved.startswith(root + "/"):
                raise Refused(f"{path} resolves outside the guest filesystem")
        out.flush()
        return _tar_ok(run(tar_command(files, root=str(mount))).returncode)
    finally:
        release()


def guard_budget(*, initial=False):
    """Read the host guard's existing policy snapshot; a running stream retains its last cap if stale."""
    try:
        budget = json.loads(GUARD_STATUS.read_text())
        quota = budget["cpu_quota_percent"]
        sample = budget["policy"]["sample_s"]
        stale = budget["policy"]["stale_s"]
        boot = BOOT_ID.read_text().strip()
        fresh = (budget["boot_id"] == boot and 0 <= time.time() - budget["observed_at"] <= stale)
        if not isinstance(quota, (int, float)) or isinstance(quota, bool) or quota <= 0:
            raise ValueError("invalid backup CPU ceiling")
        if not isinstance(sample, (int, float)) or isinstance(sample, bool) or sample <= 0:
            raise ValueError("invalid backup sample interval")
        if fresh and (not initial or budget["admission_open"]):
            return quota, sample
    except (OSError, ValueError, KeyError, TypeError):
        pass
    if initial:
        raise Deferred("the host backup guard has no fresh admission budget")
    return None


def guest_command(vmid, argv):
    return ["pct", "exec", str(vmid), "--", *argv]


def guest_stream(vmid, files, out, run=subprocess.run):
    """One supported pct stdout stream, with the producer capped inside its own container.

    The host guard controls admission and supplies changing CPU budgets. A lost status reading does
    not cancel work; its last cap stays. Only a changed budget causes a guest control request.
    Unique scope names keep cleanup from stopping another controller's export. No staged payload exists.
    """
    quota, sample = guard_budget(initial=True)
    unit = "aico-backup-export-" + secrets.token_hex(8) + ".scope"
    tar = shlex.join(tar_command(files))
    script = f'{{ {tar}; rc=$?; [ "$rc" -le 1 ]; }}'
    stop = ["systemctl", "--no-ask-password", "stop", unit]
    cleanup = shlex.join(stop) + ' >/dev/null 2>&1 || true'
    managed = ["systemd-run", "--no-ask-password", "--quiet", "--scope", "--collect", "--unit", unit,
               "--property", f"CPUQuota={quota}%", "--", "bash", "-c", script]
    # flock belongs to the guest, so two bridges/controllers cannot run exporters there together.
    body = "trap " + shlex.quote(cleanup) + " EXIT; trap 'exit 143' HUP INT TERM; " + shlex.join(managed)
    remote = ["flock", "--exclusive", "--nonblock", "--conflict-exit-code", "75",
              GUEST_LOCK, "bash", "-c", body]

    def control(argv):
        return run(guest_command(vmid, argv), capture_output=True, text=True)

    out.flush()
    with tempfile.TemporaryFile() as errors:
        process = subprocess.Popen(guest_command(vmid, remote), stdin=subprocess.DEVNULL, stdout=out, stderr=errors)
        try:
            while True:
                try:
                    code = process.wait(timeout=sample)
                    break
                except subprocess.TimeoutExpired:
                    budget = guard_budget()
                    if budget is None:
                        continue
                    next_quota, sample = budget
                    if next_quota != quota:
                        changed = control(["systemctl", "--no-ask-password", "set-property", "--runtime", unit,
                                           f"CPUQuota={next_quota}%"])
                        # The exporter may have finished just before its transient scope was collected.
                        if changed.returncode and process.poll() is None:
                            raise Refused("the guest export CPU ceiling could not be changed")
                        quota = next_quota
            if code == 75:
                raise Deferred("another file export is running in the container")
            if code:
                errors.seek(0, os.SEEK_END)
                errors.seek(max(0, errors.tell() - 300))
                raise Refused("guest file stream failed: " + errors.read().decode(errors="replace").strip())
            return 0
        finally:
            # Covers a broken stdout, budget-control failure, or cancellation as well as a normal exit.
            try:
                control(stop)
            finally:
                if process.poll() is None:
                    process.terminate()
                    process.wait()


def agent_files(vmid, files, out, run=subprocess.run):
    """QGA freezes a running VM only for the thin snapshot; selected files stream continuously on the host."""
    guest_vm = _guest_of(vmid, run)
    return disk_files(vmid, files, out, str(guest_vm["node"]), run,
                      running=guest_vm.get("status") != "stopped")


def capture(entry, out, run=subprocess.run):
    kind, vmid, files = entry["kind"], entry.get("vmid"), entry.get("files")
    if kind == "config":
        return config_dump(out)
    if files is None:
        return vzdump(kind, vmid, run)
    if kind == "host":
        return _tar_ok(run(tar_command(files, host=True)).returncode)
    if kind == "lxc":
        guest_ct = _guest_of(vmid, run, "lxc")
        if guest_ct.get("status") == "stopped":
            return disk_files(vmid, files, out, str(guest_ct["node"]), run, "lxc")
        return guest_stream(vmid, files, out, run)
    return agent_files(vmid, files, out, run)


def main(command=None, run=subprocess.run, out=None):
    words = (os.environ.get("SSH_ORIGINAL_COMMAND", "") if command is None else command).split()
    out = out or sys.stdout.buffer
    try:
        if words == ["guests"]:
            return run(["pvesh", "get", "/cluster/resources", "--type", "vm", "--output-format", "json"]).returncode
        if words == ["host-boot"]:
            out.write(BOOT_ID.read_bytes())
            out.flush()
            return 0
        if words == ["thinpool"]:
            return run(["lvs", "--noheadings", "-o", "data_percent", THIN_POOL]).returncode
        if words == ["sources"]:
            out.write(SOURCES.read_bytes() if SOURCES.is_file() else b"{}")
            out.flush()
            return 0
        if len(words) == 3 and words[0] == "capture":
            entry = load_source(words[1], words[2])
            if entry.get("vmid") is None:
                return capture(entry, out, run)
            # Keep a guest disk snapshot or exporter to one capture at a time, through cleanup.
            CAPTURE_LOCKS.mkdir(mode=0o700, parents=True, exist_ok=True)
            with (CAPTURE_LOCKS / f"guest-{entry['vmid']}.lock").open("a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                return capture(entry, out, run)
        raise Refused("unknown request; this key runs only guests, host-boot, thinpool, sources or capture SOURCE DIGEST")
    except Deferred as exc:
        sys.stderr.write(f"summitflow-pve-backup: {exc}\n")
        return 75
    except (Refused, OSError, ValueError, sqlite3.Error, subprocess.CalledProcessError) as exc:
        sys.stderr.write(f"summitflow-pve-backup: {exc}\n")
        return 2


def entrypoint(argv=None, run=subprocess.run, out=None):
    """Only the local guard subprocess can request the internal entry point; SSH sends fixed verbs."""
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) == 3 and argv[0] == "--guarded-capture":
        with capture_signals():
            return main("capture " + " ".join(argv[1:]), run=run, out=out)
    if argv:
        sys.stderr.write("summitflow-pve-backup: unknown local arguments\n")
        return 2
    words = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
    if len(words) == 3 and words[0] == "capture":
        try:
            load_source(words[1], words[2])
            return run([GUARD, "run", "--", DISPATCHER, "--guarded-capture", *words[1:]],
                       stdout=out or sys.stdout.buffer).returncode
        except (Refused, OSError, ValueError) as exc:
            sys.stderr.write(f"summitflow-pve-backup: {exc}\n")
            return 2
    return main(run=run, out=out)


if __name__ == "__main__":
    sys.exit(entrypoint())
