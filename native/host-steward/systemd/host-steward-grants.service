[Unit]
StartLimitIntervalSec=0
Description=Aico access grants
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/lib/host-steward/host-steward grants-serve
RuntimeDirectory=host-steward
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
