# host-steward: let the owner start the two root services on demand (replaces the Nightshift executor's unit.start,
# which the runner used for the space guard 165 times and agents for the check pass). Nothing else.
kasadis ALL=(root) NOPASSWD: /usr/bin/systemctl start host-steward-space-guard.service, /usr/bin/systemctl start host-steward-check.service
