#!/usr/bin/python3 -I
"""Runs ON the Proxmox host as /usr/local/sbin/aico-push: the forced command of the push-only keys of guests without Nightshift.

A guest (the Aico gem container, the Portfolio-AI VM) has no Nightshift. Its app writes the same notice it would give
`nightshift push --json` to this command's stdin (ssh pve-alerts), and this sends it to the owner's phone with the
dead-man alarm's own sender (nightshift.deadman.send: the app route and Web Push, using the credentials only root holds
here). A key can do nothing else: no shell, the only argument is the caller's name, fixed in that key's authorized_keys
line (`command="/usr/local/sbin/aico-push portfolio"`; none means "aico"; SSH_ORIGINAL_COMMAND is ignored), and the
notice is checked field by field against that caller's row in CALLERS (its source, key form, link host, size).

The notice's optional "open" link is what a tap opens, as for the workstation's own pushes (`nightshift push --open`):
the caller's own origin only (its host prefix in Nightshift's site config, open_hosts: "aico." or "port."), plain and at
most 300 characters.
deadman.send has no parameter for it, so it is added to the two messages deadman.send builds (the Web Push payload's
"open", the app item's Open button) by wrapping deadman.push and deadman.fcm_item for that one call. The journal
(tag aico-push) gets one line per push with the link and which messages carried it.

One push per key: a key already in the push log (for a caller with a window, within it) is answered "already sent" and
nothing goes out again.
Never prints key material, tokens or subscription endpoints.
"""

import json
import re
import sys
import syslog
import time

sys.path.insert(0, "/usr/local/lib/nightshift-exec/current")

MAX_STDIN = 8192
OPEN_MAX = 300
OPEN_PATH = r"(/[0-9A-Za-z/_.-]{0,60})?(\?[0-9A-Za-z_.=&-]{1,100})?"
DEFAULT_CALLER = "aico"

# One row per forced-command name. source: the notice's "source"; label: its name in messages; key: the whole key form (the log key is
# log_prefix + key); kinds / severities: what it may send (deadman.send knows no kinds; a severity passes through);
# host: prefix of the open_hosts entry its links may use; path: what may follow that origin; dedupe_s: how long a key
# in the push log blocks a repeat (None: for ever); tray_silent: a notice with push "tray" goes out as a silent info.
CALLERS = {
    "aico": {
        "source": "aico",
        "label": "Aico",
        "key": re.compile(r"^[a-z]{2,12}:[0-9A-Za-z_.-]{1,64}$"),
        "log_prefix": "aico:",
        "kinds": {"question", "todo", "info"},
        "severities": {"warning", "info"},
        "title_max": 120,
        "body_max": 400,
        "host": "aico.",
        "path": OPEN_PATH,
        "dedupe_s": None,
        "tray_silent": False,
        "detail": "Sent for Aico on the gem container, which has no Nightshift of its own.",
    },
    "portfolio": {
        "source": "portfolio-ai",
        "label": "Portfolio-AI",
        "key": re.compile(r"^portfolio-ai:[0-9A-Za-z_.:-]{1,80}$"),
        "log_prefix": "",
        "kinds": {"alert", "todo", "info"},
        "severities": {"critical", "warning", "info", "ok"},
        "title_max": 200,
        "body_max": 1000,
        "host": "port.",
        "path": OPEN_PATH + r"(#[0-9A-Za-z_-]{1,40})?",
        "dedupe_s": 86400,
        "tray_silent": True,
        "detail": "Sent for Portfolio-AI on VM 180, which has no Nightshift of its own.",
    },
}


def plain(value: object, longest: int) -> bool:
    return isinstance(value, str) and 1 <= len(value) <= longest and value.isprintable()


def origin_for(caller: dict) -> str | None:
    """https://<the caller's host>, from Nightshift's site config (the open_hosts entry with the caller's prefix)."""
    from nightshift import siteconf

    host = next((h for h in siteconf.open_hosts() if h.startswith(caller["host"])), "")
    return f"https://{host}" if host else None


def open_link_ok(link: object, origin: str | None, caller: dict = CALLERS[DEFAULT_CALLER]) -> bool:
    """A plain link on the caller's origin: https, no user, port or spaces, at most OPEN_MAX characters."""
    if origin is None or not isinstance(link, str) or len(link) > OPEN_MAX or not link.isascii():
        return False
    return re.fullmatch(re.escape(origin) + caller["path"], link) is not None


def check(text: str, origin: str | None = None, caller: dict = CALLERS[DEFAULT_CALLER]) -> dict | str:
    """The notice as a dict, or why it is refused."""
    try:
        notice = json.loads(text)
    except ValueError:
        return "not JSON"
    if not isinstance(notice, dict):
        return "not an object"
    if notice.get("v") != 1 or notice.get("source") != caller["source"] or notice.get("kind") not in caller["kinds"]:
        return f"not a {caller['label']} notice v1"
    if notice.get("severity") not in caller["severities"]:
        return "severity not allowed"
    if not plain(notice.get("title"), caller["title_max"]) or not plain(notice.get("body"), caller["body_max"]):
        return "title or body is empty, too long or not plain text"
    key = notice.get("key")
    if not isinstance(key, str) or not caller["key"].match(key):
        return "bad key"
    if "open" in notice and not open_link_ok(notice["open"], origin, caller):
        return f"open must be a plain link on the {caller['label']} origin"
    return notice


def send_with_link(deadman, link: str, *args) -> tuple[tuple[str, bool], set[str]]:
    """deadman.send(*args) with `link` on its Web Push payload ("open": a tap opens it) and on the app item (an Open
    button). Returns (send's result, the routes that carried it: web, app)."""
    carried = set()
    real_push, real_item = deadman.push, deadman.fcm_item

    def push(sub, payload, *rest, **kw):
        carried.add("web")
        return real_push(sub, {**payload, "open": link}, *rest, **kw)

    def item(entry, base):
        carried.add("app")
        message = json.loads(real_item(entry, base))
        message["actions"] = [{"id": "open", "label": "Open", "tier": "view", "url": link}]
        return json.dumps(message, ensure_ascii=False).encode()

    deadman.push, deadman.fcm_item = push, item
    try:
        return deadman.send(*args), carried
    finally:
        deadman.push, deadman.fcm_item = real_push, real_item


def already_sent(log: object, key: str, window: int | None, now: float) -> bool:
    """The key is in the push log (newer than `window` seconds, when there is one)."""
    if not isinstance(log, list):
        return False
    for e in log:
        if isinstance(e, dict) and e.get("key") == key:
            ts = e.get("ts")
            if window is None or not isinstance(ts, int | float) or now - ts < window:
                return True
    return False


def main(argv: list[str] | None = None) -> int:
    from nightshift import deadman

    args = sys.argv[1:] if argv is None else argv
    name = args[0] if args else DEFAULT_CALLER
    caller = CALLERS.get(name) if len(args) <= 1 else None
    if caller is None:
        print("refused: unknown caller", file=sys.stderr)
        return 2
    text = sys.stdin.read(MAX_STDIN + 1)
    notice = "too long" if len(text) > MAX_STDIN else check(text, origin_for(caller), caller)
    if isinstance(notice, str):
        print(f"refused: {notice}", file=sys.stderr)
        return 2
    key = f"{caller['log_prefix']}{notice['key']}"
    log_path = deadman.STATE_DIR / "log.json"
    now = time.time()
    if already_sent(deadman._read_json(log_path, []), key, caller["dedupe_s"], now):
        print(f"{key}: already sent")
        return 0
    severity = notice["severity"]
    if caller["tray_silent"] and notice.get("push") == "tray":
        severity = "info"  # no tray on this route: a silent copy for the record
    send_args = (
        deadman.load_creds(deadman.CREDS),
        notice["title"],
        notice["body"],
        caller["detail"],
        severity,
        key,
        now,
        log_path,
        deadman.load_fcm(deadman.CREDS),
    )
    link = notice.get("open")
    if link:
        (outcome, retry), carried = send_with_link(deadman, link, *send_args)
    else:
        (outcome, retry), carried = deadman.send(*send_args), set()
    syslog.openlog("aico-push")
    syslog.syslog(f"{name} {key}: {outcome} open={link or '-'} carried={','.join(sorted(carried)) or '-'}")
    print(f"{key}: {outcome}")
    return 75 if retry or not outcome.startswith("sent") else 0


if __name__ == "__main__":
    raise SystemExit(main())
