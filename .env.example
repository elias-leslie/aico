# Aico environment variable reference.
# Nothing loads a .env file: Aico reads only process environment variables.
# The desktop runtime runs as the aico-shell.service user unit, so set overrides
# in a drop-in (`systemctl --user edit aico-shell.service`, then
# `Environment=NAME=value` under [Service]) and restart Aico. For a directly-run
# AppImage or `npm start`, export them in the launching shell.
# See docs/project-guide.md#configuration. Keep real secrets out of git.

# FastAPI sidecar. Loopback is the safe default.
AICO_SIDECAR_HOST=127.0.0.1
AICO_SIDECAR_PORT=8005
# 1 allows a non-loopback AICO_SIDECAR_HOST and any Host header. The sidecar is
# unauthenticated; otherwise it answers only Host 127.0.0.1, localhost or [::1].
# AICO_SIDECAR_ALLOW_REMOTE=0

# Chrome extension IDs the sidecar trusts as browser origins (comma-separated).
# Default: the stable ID from the "key" in extension/manifest.json. Override only
# for a fork or re-keyed extension.
# AICO_EXTENSION_IDS=oejadbpdecaenbbihglcnchnkmlilmjf

# App and sidecar state (selection SQLite, widget events, widget state). Set the
# same value for aico-owner.service. The launcher pidfile, lock and launcher.log
# always use ${XDG_STATE_HOME:-~/.local/state}/aico.
# AICO_STATE_DIR=/home/you/.local/state/aico

# Speech-to-text websocket for push-to-talk dictation. Unset uses the default
# below; there is no off switch. If nothing answers there, only dictation fails.
# AICO_VOICE_WS=ws://127.0.0.1:8003/api/voice/ws?user_id=aico&app=aico

# Optional shortcut overrides.
# AICO_SELECTION_HOTKEY=CommandOrControl+Shift+Space
# AICO_VOICE_HOTKEY=CommandOrControl+Shift+M

# Agent launch admission. New agent TUIs are deferred (never killed) only while
# the host is under memory pressure; there is no concurrency cap by default.
# AICO_AGENT_MIN_AVAILABLE_GIB=6
# AICO_AGENT_MAX_PSI_SOME_AVG60=10
# AICO_AGENT_MAX_PSI_FULL_AVG60=2
# AICO_AGENT_MAX_PSI_FULL_AVG10=5
# Optional emergency ceiling on concurrently active agents (unset = no ceiling).
# AICO_AGENT_MAX_ACTIVE=
# Operator override: 1 bypasses admission only, never ownership/scope checks.
# AICO_AGENT_ADMISSION_OVERRIDE=

# Optional explicit Python for the sidecar.
# AICO_SIDECAR_PYTHON=/absolute/path/to/python
