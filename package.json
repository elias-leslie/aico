{
  "name": "aico",
  "version": "0.2.0",
  "description": "AI companion with a browser and phone view, all over Tether-owned tmux sessions.",
  "license": "Apache-2.0",
  "type": "module",
  "aico": {
    "sameLayerImports": {
      "@aico/web-frontend": [
        "@aico/ui-kit"
      ]
    }
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "biome check .",
    "boundaries": "node scripts/boundaries.mjs && depcruise packages --config .dependency-cruiser.cjs --ignore-known",
    "check-stages": "node scripts/check-stages.mjs",
    "boundaries:baseline": "depcruise packages --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "22.20.4",
    "dependency-cruiser": "18.7.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "browserslist": "^4.28.7",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "sharp": "0.35.5",
    "source-map-js": "^1.2.2",
    "ws": "^8.20.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
