{
  "name": "aico",
  "version": "0.1.1",
  "description": "Floating-widget desktop AI companion (Electron + xterm.js), a client of the Tether session daemon.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "desktopName": "aico.desktop",
  "scripts": {
    "postinstall": "install-electron",
    "start": "npm run build && electron-vite preview",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "npm run build && electron-builder --linux AppImage --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": ".venv/bin/python -m pytest scripts/tests",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:scripts && npm run build",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@electron/rebuild": "^4.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.19.7",
    "@xterm/headless": "6.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  },
  "build": {
    "appId": "dev.eliasleslie.aico",
    "productName": "Aico",
    "directories": { "output": "dist/electron" },
    "files": ["out/**/*", "package.json", "assets/icon.png", "assets/tray/*.png"],
    "asarUnpack": ["**/node_modules/node-pty/**"],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "assets/icon.png",
      "executableName": "aico",
      "syncDesktopName": true
    }
  }
}
