{
  "name": "aico",
  "version": "0.2.0",
  "description": "Floating-widget desktop AI companion (Electron + xterm.js), a client of the Tether session daemon.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "desktopName": "aico.desktop",
  "scripts": {
    "postinstall": "install-electron",
    "start": "npm run build:desktop && electron-vite preview",
    "build": "npm run build:desktop && npm run build --workspace tether && npm run build --workspace web/server && npm run build --workspace web/frontend",
    "build:desktop": "electron-vite build",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace tether && tsc --noEmit -p web/server && tsc --noEmit -p web/frontend",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@agent-hub/chat-ui": "file:vendor/agent-hub-chat-ui-0.4.1.tgz",
    "@agent-hub/sdk": "file:tether/vendor/agent-hub-sdk-0.1.2.tgz",
    "@biomejs/biome": "2.5.11",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "5.102.8",
    "@types/node": "^22.19.7",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@xterm/headless": "6.0.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@homebridge/dbus-native": "^0.7.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    },
    "@babel/core": "^7.29.6",
    "browserslist": "^4.28.7",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "sharp": "0.35.5",
    "source-map-js": "^1.2.2",
    "ws": "^8.20.1"
  },
  "workspaces": [
    "tether",
    "web/frontend",
    "web/server"
  ]
}
