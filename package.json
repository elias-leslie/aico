{
  "name": "aico",
  "version": "0.1.1",
  "description": "Floating-widget desktop AI companion (Electron + tmux + xterm.js).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "npm run build && electron-vite preview",
    "build": "electron-vite build && npm run build:owner",
    "build:owner": "esbuild electron/main/owner-service.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/main/owner-service.mjs",
    "dev": "electron-vite dev",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist:sidecar": ".venv/bin/pyinstaller --noconfirm --clean --log-level WARN --name aico-sidecar --distpath dist/sidecar --workpath dist/.pyi-build --specpath dist/.pyi-build --paths sidecar --collect-submodules uvicorn --collect-submodules aico_sidecar --hidden-import aico_sidecar.app sidecar/aico_sidecar/__main__.py",
    "dist": "npm run dist:sidecar && npm run build && electron-builder --linux AppImage --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sidecar": ".venv/bin/python -m pytest sidecar/tests scripts/tests",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:sidecar && npm run build",
    "lint": "biome check .",
    "check:context": "esbuild scripts/check-context.ts --bundle --platform=node --format=esm --outfile=.dev-tools/check-context.mjs && node .dev-tools/check-context.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@electron/rebuild": "^4.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.19.7",
    "electron": "^42.2.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  },
  "build": {
    "appId": "dev.eliasleslie.aico",
    "productName": "Aico",
    "directories": { "output": "dist/electron" },
    "files": ["out/**/*", "package.json", "assets/icon.png", "assets/tray/*.png", "scripts/aico-grab.sh"],
    "asarUnpack": ["**/node_modules/node-pty/**", "scripts/aico-grab.sh"],
    "extraResources": [{ "from": "dist/sidecar/aico-sidecar", "to": "sidecar/aico-sidecar" }],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "assets/icon.png",
      "executableName": "aico"
    }
  }
}
