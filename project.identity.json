{
  "schema_version": 1,
  "project": {
    "id": "aico",
    "repo_name": "aico",
    "display_name": "Aico",
    "legacy_ids": [
      "a-term",
      "aterm",
      "terminal",
      "tether"
    ],
    "repo_aliases": [
      "a-term",
      "aterm",
      "terminal",
      "tether"
    ],
    "lifecycle": "active"
  },
  "branding": {
    "short_name": "Aico",
