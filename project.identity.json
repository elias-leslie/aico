      "aico-shell.service"
    ],
    "manual_workers": [
      "tether@default.service"
    ]
  },
  "hosts": {
    "browser_frontend": "aico.summitflow.dev"
  },
  "artifacts": {
    "cache_dir_name": "aico",
    "upload_dir_name": "aico-uploads",
    "env_prefix": "AICO"
  },
  "repository": {
    "owner": "elias-leslie",
    "name": "aico",
    "ssh_url": "git@github.com:elias-leslie/aico.git",
    "https_url": "https://github.com/elias-leslie/aico"
  }
