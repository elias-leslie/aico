# TEMPLATE — do not `cp` this into systemd directly: `__PROJECT_ROOT__` is a
# placeholder. scripts/install.sh (source installs) and
# `st service rebuild aico` (managed hosts) render it with the repo path and
# install the unit to ~/.config/systemd/user/; see docs/INSTALL.md.
[Unit]
Description=Aico desktop shell
After=graphical-session.target
# Start at login with the graphical session: GNOME imports WAYLAND_DISPLAY into
# the user manager before graphical-session.target, but after default.target, so
# a default.target install was always skipped and Aico never opened after a
# reboot. The condition still guards a manual start without a desktop; the
# launcher imports its display variables and starts this same unit.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
Slice=app.slice
WorkingDirectory=__PROJECT_ROOT__
# The runner, build and Chromium helpers start in this unit's cgroup.
# Once a window opens, the desktop moves the Electron main process into
# app-aico-<pid>.scope, and the tmux clients it spawns afterwards start
# there too. `journalctl --user -u aico-shell` therefore misses most of Aico's
# output; read `journalctl --user -u app-aico-<MainPID>.scope` as well.
# Electron stays this unit's MainPID, so a stop still reaches it. Tether owns
# the durable tmux servers and pane workloads in its own units; they survive
# this unit stopping.
# SIGTERM only the Electron main process so app.quit can detach terminals and close
# renderers cleanly; systemd then SIGKILLs any helper left in this unit's
# cgroup after the main process exits or TimeoutStopSec passes. Helpers in the
# desktop scope are not this unit's to kill: they exit with Electron, and
# scripts/aico-stop.sh stops that exact scope.
KillMode=mixed
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
Environment=AICO_OWNER=aico
Environment=AICO_WORKLOAD_CLASS=desktop-runtime
Environment=AICO_RUNTIME_UNIT=aico-shell.service
# Inherit WAYLAND_DISPLAY (and DISPLAY/XAUTHORITY for Xwayland children) from
# the graphical user manager; never hard-code them.
# Optional local agent launcher wrappers may live in %h/.claude/bin and
# %h/.codex/bin. Keep common user bin paths ahead of system paths.
Environment=PATH=%h/.claude/bin:%h/.codex/bin:%h/bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__PROJECT_ROOT__/scripts/aico-run-foreground.sh
# No ExecStop wrapper: systemd applies KillMode=mixed directly to this
# exact unit. scripts/aico-stop.sh is the guarded operator-facing stop path;
# invoking it recursively as this unit's ExecStop would deadlock unit teardown.
TimeoutStartSec=60
TimeoutStopSec=20

[Install]
WantedBy=graphical-session.target
