# SummitFlow-managed tether@default, a manual worker of the aico project:
# `st service rebuild aico --worker tether@default` renders this (with
# __PROJECT_ROOT__ set to the release it built) and restarts the unit, so
# ExecStartPre installs that release into the stable path before the daemon
# starts. A plain `st service rebuild aico` does the same when tether/ or this
# file changed since the release the running daemon came from. Otherwise
# identical to tether/systemd/tether@.service (see its notes: tmux servers are
# separate units, so a restart never stops a pane).
[Unit]
Description=Tether session daemon (default)
Documentation=https://github.com/elias-leslie/tether

[Service]
Type=simple
Slice=app.slice
WorkingDirectory=__PROJECT_ROOT__/tether
# "-": a missing release never keeps the installed daemon from starting.
ExecStartPre=-__PROJECT_ROOT__/tether/scripts/install-release.sh
ExecStart=%h/.local/lib/tether/bin/tether --instance default serve
Restart=on-failure
RestartSec=2
UMask=0077
Environment=PATH=%h/.claude/bin:%h/.codex/bin:%h/bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# Sibling checkouts (agent-hub, codex-config) live here, not ~/projects.
Environment=TETHER_PROJECTS_DIR=/srv/workspaces/projects
# Read the host verdict Nightshift publishes in /run/nightshift, and keep this
# Tether's memory event record in its state dir, where Nightshift reads it.
Environment=TETHER_NIGHTSHIFT_ADMISSION=/run/nightshift/admission.json
Environment=TETHER_NIGHTSHIFT_EVENTS=%h/.local/state/tether/default/memory-events.jsonl
# The Aico web app's address, for the ask links in needs-you.json (the tray's
# Aico row); the same host as hosts.browser_frontend in project.identity.json.
Environment=TETHER_AICO_URL=https://aico.summitflow.dev
# systemd-oomd picks this unit only when no other candidate is left.
ManagedOOMPreference=avoid
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes

[Install]
WantedBy=default.target
