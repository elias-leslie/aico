# Asks the running aico-web for the nightly readable copy of the notes (staging folder, then rclone copy to Drive).
# Not a template: nothing here names a checkout, so a host that deploys by release (st service rebuild) can use it as is.
# aico-web decides whether this host exports tonight (AICO_EXPORT_DEFER_TO) and exits nonzero here when it cannot:
# 503 means this host has no Drive login yet (scripts/authorize-notes-drive.sh). No retries.
[Unit]
Description=Aico notes export (readable copy of the notes on Drive)
Wants=aico-web.service
After=aico-web.service

[Service]
Type=oneshot
# 3002 is the web app's port (project.identity.json runtime.backend_port).
ExecStart=/usr/bin/curl --fail-with-body --silent --show-error --request POST http://127.0.0.1:3002/api/export/notes
Nice=10
SyslogIdentifier=aico-notes-export
