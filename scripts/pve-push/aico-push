#!/usr/bin/python3 -I
"""Runs ON the Proxmox host as /usr/local/sbin/aico-push: the forced command of the Aico gem container's push key.

The container has no Nightshift. Its aico-web writes the same notice it would give `nightshift push --json` to this
command's stdin (ssh pve-alerts), and this sends it to the owner's phone with the dead-man alarm's own sender
(nightshift.deadman.send: the app route and Web Push, using the credentials only root holds here). The key can do
nothing else: no shell, no arguments (SSH_ORIGINAL_COMMAND is ignored), and the notice is checked field by field.

One push per key: a key already in the push log is answered "already sent" and nothing goes out again.
Never prints key material, tokens or subscription endpoints.
"""

import json
import re
import sys
import time

sys.path.insert(0, "/usr/local/lib/nightshift-exec/current")

MAX_STDIN = 8192
KEY = re.compile(r"^[a-z]{2,12}:[0-9A-Za-z_.-]{1,64}$")
SEVERITY = {"warning": "warning", "info": "info"}
KINDS = {"question", "todo", "info"}


def plain(value: object, longest: int) -> bool:
    return isinstance(value, str) and 1 <= len(value) <= longest and value.isprintable()


def check(text: str) -> dict | str:
    """The notice as a dict, or why it is refused."""
    try:
        notice = json.loads(text)
    except ValueError:
        return "not JSON"
    if not isinstance(notice, dict):
        return "not an object"
    if notice.get("v") != 1 or notice.get("source") != "aico" or notice.get("kind") not in KINDS:
        return "not an Aico notice v1"
    if notice.get("severity") not in SEVERITY:
        return "severity must be info or warning"
    if not plain(notice.get("title"), 120) or not plain(notice.get("body"), 400):
        return "title or body is empty, too long or not plain text"
    key = notice.get("key")
    if not isinstance(key, str) or not KEY.match(key):
        return "bad key"
    return notice


def main() -> int:
    from nightshift import deadman

    text = sys.stdin.read(MAX_STDIN + 1)
    notice = "too long" if len(text) > MAX_STDIN else check(text)
    if isinstance(notice, str):
        print(f"refused: {notice}", file=sys.stderr)
        return 2
    key = f"aico:{notice['key']}"
    log_path = deadman.STATE_DIR / "log.json"
    log = deadman._read_json(log_path, [])
    if any(isinstance(e, dict) and e.get("key") == key for e in log if isinstance(log, list)):
        print(f"{key}: already sent")
        return 0
    outcome, retry = deadman.send(
        deadman.load_creds(deadman.CREDS),
        notice["title"],
        notice["body"],
        "Sent for Aico on the gem container, which has no Nightshift of its own.",
        SEVERITY[notice["severity"]],
        key,
        time.time(),
        log_path,
        deadman.load_fcm(deadman.CREDS),
    )
    print(f"{key}: {outcome}")
    return 75 if retry or not outcome.startswith("sent") else 0


if __name__ == "__main__":
    raise SystemExit(main())
