# Compatibility unit for old per-host enablements. The daemon now owns every
# pinned fleet connection. Starting this unit starts that one daemon only.
[Unit]
Description=Aico fleet link to %i
Requires=tether@default.service
After=tether@default.service

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes

[Install]
WantedBy=default.target
