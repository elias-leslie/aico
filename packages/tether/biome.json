{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "root": false,
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**", "vitest.config.ts", "package.json", "biome.json", "tsconfig.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "paths": {
                  "node:sqlite": "Only the store package imports node:sqlite."
                },
                "patterns": [
                  {
                    "group": [
                      "@aico/agent",
                      "@aico/agent/**",
                      "@aico/checks",
                      "@aico/checks/**",
                      "@aico/jobs",
                      "@aico/jobs/**",
                      "@aico/notes",
                      "@aico/notes/**",
                      "@aico/notify",
                      "@aico/notify/**",
                      "@aico/status",
                      "@aico/status/**",
                      "@aico/store",
                      "@aico/store/**",
                      "@aico/ui-kit",
                      "@aico/ui-kit/**",
                      "@aico/usage",
                      "@aico/usage/**",
                      "@aico/web-frontend",
                      "@aico/web-frontend/**",
                      "@aico/web-server",
                      "@aico/web-server/**"
                    ],
                    "message": "@aico/tether (layer 5): import only @aico/shared, @aico/context, @aico/fleet, @aico/tasks, @aico/tether-client (package.json aico.imports; depcruise is the gate)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
