{
  "note": "Token formats issued by well-known services. Each pattern is the service's own shape (fixed prefix plus length), so it never fires on git hashes, UUIDs or base64 data. Edge: not preceded by a token character.",
  "shapes": [
    {
      "name": "Telegram bot token",
      "pattern": "(?<![A-Za-z0-9_-])\\d{8,10}:[A-Za-z0-9_-]{35}(?![A-Za-z0-9_-])"
    },
    {
      "name": "OpenAI, Anthropic and similar (sk-)",
      "pattern": "(?<![A-Za-z0-9_-])sk-[A-Za-z0-9_-]{16,}"
    },
    {
      "name": "GitHub",
      "pattern": "(?<![A-Za-z0-9_-])(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})"
    },
    {
      "name": "GitLab",
      "pattern": "(?<![A-Za-z0-9_-])glpat-[A-Za-z0-9_-]{20,}"
    },
    {
      "name": "AWS access key id",
      "pattern": "(?<![A-Za-z0-9+/=_-])(?:AKIA|ASIA)[A-Z0-9]{16}(?![A-Za-z0-9+/=_-])"
    },
    {
      "name": "Slack",
      "pattern": "(?<![A-Za-z0-9_-])xox[abprs]-[A-Za-z0-9-]{10,}"
    },
    {
      "name": "Google API key",
      "pattern": "(?<![A-Za-z0-9_-])AIza[0-9A-Za-z_-]{35}"
    },
    {
      "name": "Google OAuth access token",
      "pattern": "(?<![A-Za-z0-9_-])ya29\\.[A-Za-z0-9_-]{30,}"
    },
    {
      "name": "Stripe",
      "pattern": "(?<![A-Za-z0-9_-])[sr]k_(?:live|test)_[A-Za-z0-9]{16,}"
    },
    {
      "name": "npm",
      "pattern": "(?<![A-Za-z0-9_-])npm_[A-Za-z0-9]{36}(?![A-Za-z0-9_])"
    },
    {
      "name": "Hugging Face",
      "pattern": "(?<![A-Za-z0-9_-])hf_[A-Za-z0-9]{34,}"
    },
    {
      "name": "SendGrid",
      "pattern": "(?<![A-Za-z0-9_-])SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}"
    },
    {
      "name": "JWT",
      "pattern": "(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"
    },
    {
      "name": "Password in a URL",
      "pattern": "(?<=://[^\\s:/@]{1,64}:)[^\\s@/]{3,}(?=@)"
    }
  ],
  "privateKey": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)",
  "bearer": "\\b(Bearer\\s+)(?=[A-Za-z0-9._~+/=-]*\\d)[A-Za-z0-9._~+/=-]{12,}",
  "bearerBroad": "\\b(Bearer\\s+)[A-Za-z0-9._~+/=-]{12,}",
  "assignment": {
    "note": "A secret-like name set to a value, as NAME=value, NAME: value or \"name\": \"value\": only the value is hidden. Names end in token, secret, password, passwd or passphrase, one of the qualified keys (api, access, private, auth, signing, encryption, master, license, ssh, client), or an ALL_CAPS_KEY. Values need a digit and 6+ characters and no brackets, $ or <, nor a.b.c chains, so code (token = tokenOf(x)), placeholders (<redacted>, $VAR, ${VAR}, ***) and prose (the token: is missing) stay visible. {name} stands for the name pattern of each set.",
    "names": [
      {
        "flags": "gi",
        "pattern": "[A-Za-z0-9_.-]*(?:token|secret|password|passwd|passphrase|(?:api|access|private|auth|signing|encryption|master|license|ssh|client)[_-]?key)"
      },
      {
        "flags": "g",
        "pattern": "[A-Z][A-Z0-9]*_KEY"
      }
    ],
    "values": [
      "(?<=\\b{name}\\\\?[\"']?\\s*=\\s*\\\\?[\"']?)(?![%*\\u2022\\\\\"'\\s])(?!(?:undefined|redacted|placeholder|changeme)\\b)(?![A-Za-z_]+\\.[A-Za-z_]+\\.)(?=[^\\s\"'`,;&<>(){}\\[\\]$\\\\]*\\d)[^\\s\"'`,;&<>(){}\\[\\]$\\\\]{6,}",
      "(?<=\\b{name}\\\\?[\"']?\\s*:\\s*\\\\?[\"'])(?![%*\\u2022\\\\\"'\\s])(?!(?:undefined|redacted|placeholder|changeme)\\b)(?![A-Za-z_]+\\.[A-Za-z_]+\\.)(?=[^\\s\"'`,;&<>(){}\\[\\]$\\\\]*\\d)[^\\s\"'`,;&<>(){}\\[\\]$\\\\]{6,}",
      "(?<=\\b{name}\\\\?[\"']?\\s*:[ \\t]+)(?![%*\\u2022\\\\\"'\\s])(?!(?:undefined|redacted|placeholder|changeme)\\b)(?![A-Za-z_]+\\.[A-Za-z_]+\\.)(?=[^\\s\"'`,;&<>(){}\\[\\]$\\\\]*\\d)[^\\s\"'`,;&<>(){}\\[\\]$\\\\]{6,}"
    ]
  }
}
