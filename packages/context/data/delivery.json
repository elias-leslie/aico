{
  "about": "Context delivery (deliver.ts): each tool's byte budget, the order the budget cuts sections in, where the tool-usage block comes from, and how much recent activity to show. Guardrail and mandate sections are never cut.",
  "tools": {
    "claude-code": { "budgetBytes": 32768 },
    "codex": { "budgetBytes": 32768 },
    "pi": { "budgetBytes": 32768 }
  },
  "aliases": { "claude": "claude-code", "claude_code": "claude-code" },
  "profile": "agent_startup",
  "cutOrder": ["activity", "tool-usage", "instruction", "role", "project"],
  "toolUsage": {
    "command": [
      "st",
      "tools",
      "manifest",
      "--format",
      "inject",
      "--density",
      "adaptive",
      "--profile",
      "agent_startup"
    ],
    "timeoutMs": 5000
  },
  "activity": { "maxLines": 5, "maxAgeDays": 7 }
}
