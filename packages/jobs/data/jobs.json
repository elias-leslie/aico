{
  "description": "Aico jobs. home prefers a machine; lease_host (default home) is the single durable lease authority; workers (default home only) lists machines that may take over after lease_s. at is a daily local time, every_min repeats after completion. run is a local POST or command argv.",
  "jobs": [
    {
      "kind": "notes-export",
      "what": "Notes export to Drive",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "03:30",
      "run": {
        "post": "/api/export/notes"
      },
      "lease_s": 120
    },
    {
      "kind": "context-import",
      "what": "Agent Hub import into Aico",
      "project": "aico",
      "home": "davion-sidarli",
      "every_min": 10,
      "run": {
        "command": [
          "/home/kasadis/.summitflow/services/projects/aico/current/source/packages/web-server/scripts/aico",
          "context",
          "import-agent-hub",
          "--no-status",
          "--checkout",
          "/srv/workspaces/projects/agent-hub"
        ]
      },
      "lease_s": 300
    },
    {
      "kind": "context-unused",
      "what": "Loaded context use",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "04:10",
      "run": { "post": "/api/context/check" },
      "lease_s": 300
    },
    {
      "kind": "usage-collect",
      "what": "Usage collection",
      "project": "aico",
      "home": "davion-sidarli",
      "every_min": 5,
      "run": {
        "command": [
          "/home/kasadis/.summitflow/services/projects/aico/current/source/packages/web-server/scripts/aico",
          "usage",
          "collect"
        ]
      },
      "lease_s": 180
    }
  ]
}
