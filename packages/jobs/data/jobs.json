{
  "description": "Aico jobs. either names the machines a routine registered with --hosts either runs on (home first, the always-on lease_host holds the lease). home prefers a machine; lease_host (default home) is the single durable lease authority; workers (default home only) lists machines that may take over after lease_s. at is a daily time of day in the zone zones names for the job's home machine (or its own tz), every_min repeats after completion. run is a local POST or command argv. Relative command executables resolve from this file's directory, so they stay in the scheduler's deployed release.",
  "zones": {
    "davion-sidarli": "America/New_York",
    "aico": "UTC"
  },
  "either": {
    "tz": "America/New_York",
    "home": "davion-sidarli",
    "lease_host": "aico",
    "workers": ["davion-sidarli", "aico"]
  },
  "jobs": [
    {
      "kind": "backups-drill",
      "what": "Aico restore drill: checks daily, runs monthly",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "06:00",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "drill", "--scheduled"]
      },
      "lease_s": 300
    },
    {
      "kind": "check-nightly",
      "what": "Nightly full check and live session checks",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "01:30",
      "run": {
        "command": ["../../web-server/scripts/aico", "nightly", "--source", "aico"]
      },
      "lease_s": 300
    },
    {
      "kind": "github-publish",
      "what": "Nightly GitHub publication",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "03:05",
      "run": {
        "command": ["../../web-server/scripts/aico", "publish", "--all"]
      },
      "lease_s": 300
    },
    {
      "kind": "morning-digest",
      "what": "Morning digest to the phone",
      "project": "aico",
      "home": "davion-sidarli",
      "lease_host": "aico",
      "workers": ["davion-sidarli", "aico"],
      "fallback": ["davion-sidarli"],
      "at": "07:30",
      "run": {
        "post": "/api/digest/push"
      },
      "lease_s": 120
    },
    {
      "kind": "caretaker",
      "what": "Caretaker: a problem that outlasts self-healing gets one action from a short list",
      "project": "aico",
      "home": "davion-sidarli",
      "lease_host": "aico",
      "workers": ["davion-sidarli", "aico"],
      "every_min": 5,
      "run": {
        "command": ["../../web-server/scripts/aico", "caretaker", "run"]
      },
      "lease_s": 600
    },
    {
      "kind": "notes-export",
      "what": "Notes export to Drive",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "03:30",
      "run": {
        "post": "/api/export/notes"
      },
      "lease_s": 120
    },
    {
      "kind": "note-reminders",
      "what": "Note reminders to the phone",
      "project": "aico",
      "home": "davion-sidarli",
      "lease_host": "aico",
      "workers": ["davion-sidarli", "aico"],
      "fallback": ["davion-sidarli"],
      "every_min": 1,
      "run": {
        "post": "/api/notes/reminders/run"
      },
      "lease_s": 60
    },
    {
      "kind": "notes-export-aico",
      "what": "Notes export to Drive (standby)",
      "project": "aico",
      "home": "aico",
      "at": "03:30",
      "run": {
        "post": "/api/export/notes"
      },
      "lease_s": 120
    },
    {
      "kind": "aico-state-snapshot",
      "what": "Consistent copies of the Aico databases for backup (standby)",
      "project": "aico",
      "home": "aico",
      "every_min": 60,
      "run": {
        "command": ["systemctl", "--user", "start", "aico-state-snapshot.service"]
      },
      "lease_s": 300
    },
    {
      "kind": "context-unused",
      "what": "Loaded context use",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "04:10",
      "run": {
        "post": "/api/context/check"
      },
      "lease_s": 300
    },
    {
      "kind": "usage-collect",
      "what": "Usage collection",
      "project": "aico",
      "home": "davion-sidarli",
      "every_min": 5,
      "run": {
        "command": ["../../web-server/scripts/aico", "usage", "collect"]
      },
      "lease_s": 180
    },
    {
      "kind": "backups-native",
      "what": "T7 recovery points",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "native", "--scheduled"]
      },
      "lease_s": 300,
      "every_min": 240
    },
    {
      "kind": "backups-drive",
      "what": "Google Drive backup",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "drive", "--scheduled"]
      },
      "lease_s": 300,
      "at": "04:00"
    },
    {
      "kind": "backups-append",
      "what": "Aico databases to CT 160",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "append", "--scheduled"]
      },
      "lease_s": 300,
      "every_min": 60
    },
    {
      "kind": "backups-snapshots",
      "what": "Work recovery snapshots",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "snapshots", "--scheduled"]
      },
      "lease_s": 300,
      "every_min": 30
    },
    {
      "kind": "backups-guard",
      "what": "Backup storage read-only guard",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "guard", "--scheduled"]
      },
      "lease_s": 300,
      "every_min": 5
    },
    {
      "kind": "backups-append-aico",
      "what": "Standby databases to CT 160",
      "project": "aico",
      "home": "aico",
      "every_min": 60,
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "append", "--scheduled"]
      },
      "lease_s": 300
    },
    {
      "kind": "backups-drive-aico",
      "what": "Standby databases, its guests and the Ominull hub to Google Drive",
      "project": "aico",
      "home": "aico",
      "at": "01:30",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "drive", "--scheduled"]
      },
      "lease_s": 300
    },
    {
      "kind": "backups-verify-aico",
      "what": "Standby Drive backup read-back check",
      "project": "aico",
      "home": "aico",
      "at": "05:30",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "verify", "--scheduled"]
      },
      "lease_s": 300
    },
    {
      "kind": "backups-verify",
      "what": "Drive backup read-back check",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "05:00",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "verify", "--scheduled"]
      },
      "lease_s": 300
    },
    {
      "kind": "wip-mirror-davion-sidarli",
      "what": "Repo copies to the standby",
      "project": "aico",
      "home": "davion-sidarli",
      "every_min": 10,
      "run": {
        "command": ["../../web-server/scripts/aico", "wip", "run"]
      },
      "lease_s": 300
    },
    {
      "kind": "wip-mirror-aico",
      "what": "Repo copies to the workstation",
      "project": "aico",
      "home": "aico",
      "every_min": 10,
      "run": {
        "command": ["../../web-server/scripts/aico", "wip", "run"]
      },
      "lease_s": 300
    },
    {
      "kind": "context-sync",
      "what": "Memories, prompts and launch policy to the standby",
      "project": "aico",
      "home": "davion-sidarli",
      "every_min": 5,
      "run": {
        "command": ["../../web-server/scripts/aico", "context-sync", "run"]
      },
      "lease_s": 300
    },
    {
      "kind": "peer-release",
      "what": "Aico container on the workstation's release",
      "project": "aico",
      "home": "davion-sidarli",
      "every_min": 15,
      "run": {
        "command": ["../../../scripts/peer-release.sh", "aico-gem", "aico"]
      },
      "lease_s": 900
    }
  ]
}
