{
  "description": "Aico jobs. home prefers a machine; lease_host (default home) is the single durable lease authority; workers (default home only) lists machines that may take over after lease_s. at is a daily local time, every_min repeats after completion. run is a local POST or command argv. Relative command executables resolve from this file's directory, so they stay in the scheduler's deployed release.",
  "jobs": [
    {
      "kind": "backups-drill",
      "what": "Monthly Aico restore drill",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "06:00",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "drill", "--scheduled"]
      },
      "lease_s": 300
    },
    {
      "kind": "github-publish",
      "what": "Nightly GitHub publication",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "03:05",
      "run": {
        "command": ["../../web-server/scripts/aico", "publish", "--all"]
      },
      "lease_s": 300
    },
    {
      "kind": "notes-export",
      "what": "Notes export to Drive",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "03:30",
      "run": {
        "post": "/api/export/notes"
      },
      "lease_s": 120
    },
    {
      "kind": "context-unused",
      "what": "Loaded context use",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "04:10",
      "run": {
        "post": "/api/context/check"
      },
      "lease_s": 300
    },
    {
      "kind": "usage-collect",
      "what": "Usage collection",
      "project": "aico",
      "home": "davion-sidarli",
      "every_min": 5,
      "run": {
        "command": ["../../web-server/scripts/aico", "usage", "collect"]
      },
      "lease_s": 180
    },
    {
      "kind": "backups-native",
      "what": "T7 recovery points",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "native", "--scheduled"]
      },
      "lease_s": 300,
      "every_min": 240
    },
    {
      "kind": "backups-drive",
      "what": "Google Drive backup",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "drive", "--scheduled"]
      },
      "lease_s": 300,
      "at": "02:30"
    },
    {
      "kind": "backups-append",
      "what": "Aico databases to CT 160",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "append", "--scheduled"]
      },
      "lease_s": 300,
      "every_min": 60
    },
    {
      "kind": "backups-snapshots",
      "what": "Work recovery snapshots",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "snapshots", "--scheduled"]
      },
      "lease_s": 300,
      "every_min": 30
    },
    {
      "kind": "backups-guard",
      "what": "Backup storage read-only guard",
      "project": "aico",
      "home": "davion-sidarli",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "guard", "--scheduled"]
      },
      "lease_s": 300,
      "every_min": 5
    },
    {
      "kind": "backups-append-aico",
      "what": "Aico gem databases to CT 160",
      "project": "aico",
      "home": "aico",
      "every_min": 60,
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "append", "--scheduled"]
      },
      "lease_s": 300
    },
    {
      "kind": "backups-verify",
      "what": "Drive backup read-back check",
      "project": "aico",
      "home": "davion-sidarli",
      "at": "05:00",
      "run": {
        "command": ["../../web-server/scripts/aico", "backups", "run", "verify", "--scheduled"]
      },
      "lease_s": 300
    }
  ]
}
