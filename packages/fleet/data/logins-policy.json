{
  "writePeerPreference": ["aico"],
  "localFiles": ["update-signing-key"],
  "restrictedTools": ["claude", "claude-code", "anthropic"],
  "restrictedRoles": ["hunting", "recon", "verification"],
  "coordinatorRoles": ["coordinator"],
  "toolGrants": ["cloudflare-mcp-oauth"],
  "revealSeconds": 30,
  "maxValueBytes": 65536,
  "labPrograms": [
    "~/.summitflow/services/projects/browser-automation/current/source/src/browser_automation/login_adapter.py",
    "~/.summitflow/services/projects/browser-automation/current/source/src/browser_automation/api_adapter.py",
    "~/.summitflow/services/projects/browser-automation/previous/source/src/browser_automation/login_adapter.py",
    "~/.summitflow/services/projects/browser-automation/previous/source/src/browser_automation/api_adapter.py",
    "/srv/workspaces/projects/browser-automation/src/browser_automation/login_adapter.py",
    "/srv/workspaces/projects/browser-automation/src/browser_automation/api_adapter.py"
  ],
  "labInterpreters": "^(python[0-9.]*[a-z]*(-dbg)?|pypy[0-9.]*|node[0-9]*|nodejs|deno|bun|tsx|ts-node|bash|sh|dash|zsh|fish|ksh|csh|tcsh|env|perl[0-9.]*|ruby[0-9.]*|php[0-9.]*|lua[0-9.]*|luajit|tclsh[0-9.]*|wish|java[0-9]*|Rscript|R|awk|gawk|mawk|sed|find|xargs|timeout|nice|nohup|setsid|stdbuf|flock|chrt|taskset|ionice|unshare|nsenter|systemd-run|sudo|su|doas|ssh|make|uv|uvx|npx|pnpm|npm|yarn|busybox|script|watch|expect|gdb)$",
  "maxRpcBytes": 4194304,
  "auditMaxEntries": 2000,
  "showActivity": 5,
  "auditMaxDays": 90,
  "auditCollapseSeconds": 3600,
  "auditExplicitActions": ["reveal"],
  "auditReadActions": ["use", "tool use", "lab use", "VM operation"],
  "lockWaitSeconds": 5,
  "probePaths": [
    "/login",
    "/signin",
    "/sign_in",
    "/users/sign_in",
    "/login/canvas",
    "/auth/login",
    "/account/login"
  ],
  "probeSeconds": 12,
  "probeMaxBytes": 1048576,
  "probeMaxTries": 8
}
