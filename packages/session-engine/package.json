    "./tui/models": "./src/lifecycle/tui/models.ts",
    "./tui/registry": "./src/lifecycle/tui/registry.ts",
    "./tui/sign-in-link": "./src/lifecycle/tui/sign-in-link.ts",
    "./tui/spec": "./src/lifecycle/tui/spec.ts"
