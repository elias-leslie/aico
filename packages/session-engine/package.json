    "imports": [
      "@aico/shared",
      "@aico/context"
    ],
    "db": [
      "tether.db"
    ]
  },
  "type": "module",
  "exports": {
    "./agent-state": "./src/agent-state.ts",
    "./continuity": "./src/continuity.ts",
    "./entry-files": "./src/entry-files.ts",
    "./entry-scan": "./src/entry-scan.ts",
    "./env": "./src/env.ts",
    "./events": "./src/events.ts",
    "./generation": "./src/generation.ts",
    "./model-record": "./src/model-record.ts",
    "./paths": "./src/paths.ts",
    "./proc-facts": "./src/proc-facts.ts",
    "./proc-fs": "./src/proc-fs.ts",
    "./store": "./src/store.ts",
    "./tools": "./src/tools.ts",
    "./tui/adapters/agy-doing": "./src/lifecycle/tui/adapters/agy-doing.ts",
    "./tui/adapters/claude-code": "./src/lifecycle/tui/adapters/claude-code.ts",
