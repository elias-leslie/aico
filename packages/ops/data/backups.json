{
  "version": 1,
  "workstation": "davion-sidarli",
  "stateDir": "~/.local/state/aico/backups",
  "scratchRoot": "/srv/scratch/aico-backups",
  "sharedLock": "~/.local/state/summitflow/host-recovery/run.lock",
  "legacyHostState": "~/.local/state/summitflow/host-recovery",
  "legacyDriveState": "~/.local/state/summitflow/offsite",
  "nativeOperationsDir": "~/.local/state/summitflow/host-recovery/operations",
  "btrbkConfig": "/etc/btrbk/summitflow.conf",
  "nativeHelper": "/usr/local/sbin/summitflow-native-capture",
  "windowHelper": "/usr/local/sbin/summitflow-backup-window",
  "nativeTarget": "/mnt/summitflow-native/native",
  "nativeDriveUuid": "36a930fb-4860-47b5-9d77-f2617ae2e59b",
  "nativeSources": ["/", "/home", "/srv/workspaces", "/var/lib/docker", "/srv/models", "/var/log"],
  "subvolumes": {
    "workspaces": {
      "mount": "/srv/workspaces",
      "paths": ["/srv/workspaces"]
    },
    "home": {
      "mount": "/home",
      "paths": ["/home"]
    },
    "root": {
      "mount": "/",
      "paths": [
        "/etc",
        "/root",
        "/usr/local/bin",
        "/usr/local/sbin",
        "/usr/local/libexec",
        "/usr/local/share",
        "/opt/ominull",
        "/var/spool"
      ]
    }
  },
  "retention": {
    "drive": {
      "daily": 7,
      "weekly": 4,
      "monthly": 3,
      "legacyDays": 30,
      "legacyAfterGoodRuns": 3
    },
    "snapshot": {
      "recentHours": 6,
      "hourlyHours": 24,
      "dailyDays": 3,
      "archivedDays": 3,
      "unfinishedDays": 1,
      "pressureKeep": 3,
      "manualPerScope": 20,
      "maxDeletes": 15,
      "intervalMinutes": 15,
      "deleteBatch": 5,
      "settleSeconds": 10,
      "settleMaxSeconds": 180,
      "settleIoPressure": 10,
      "settlePollSeconds": 5
    },
    "btrbk": [
      "snapshot_preserve_min latest",
      "snapshot_preserve no",
      "target_preserve_min latest",
      "target_preserve 7d",
      "snapshot_create ondemand"
    ]
  },
  "schedule": {
    "localMinutes": 240,
    "driveAt": "04:00",
    "appendMinutes": 60,
    "snapshotMinutes": 30,
    "guardMinutes": 5,
    "freshLocalHours": 8,
    "freshDriveHours": 36,
    "freshAppendHours": 2,
    "ownerUnreadMinutes": 30,
    "runReportSeconds": 300,
    "runStuckHours": 12,
    "runReportTimeoutSeconds": 60
  },
  "pve": {
    "alias": "proxmox-gem",
    "backupKey": "~/.local/state/summitflow/backup-keys/pve-backup.ed25519",
    "appendKey": "~/.local/state/summitflow/backup-keys/pve-append.ed25519",
    "appendGuest": 160,
    "knownHosts": "~/.ssh/known_hosts",
    "thinPoolMaximumPercent": 98,
    "address": "192.168.86.39",
    "user": "root",
    "port": "22"
  },
  "append": {
    "repository": "rclone:aico-append:repo",
    "passwordFile": "~/.local/state/summitflow/backup-keys/restic-local.password"
  },
  "sqlite": {
    "dataDir": "~/.local/state/aico",
    "otherDirs": ["~/.local/state/tether/default"],
    "stagingDir": "~/.local/state/aico-snapshot",
    "machines": ["davion-sidarli", "aico"],
    "recoveryPaths": ["~/.config/systemd/user", "~/.config/aico", "~/.config/tether"]
  },
  "prepare": {
    "ominull-production-state": {
      "project": "ominull",
      "extension": "ominull.backup",
      "root": "/srv/workspaces/projects/ominull",
      "command": ["/srv/workspaces/projects/ominull/scripts/st-ominull-backup"]
    }
  },
  "limits": {
    "cacheBytes": 1073741824,
    "maxOutputBytes": 268435456,
    "gomaxprocs": "4",
    "gomemlimit": "2GiB",
    "lockWait": "5m"
  },
  "webUrl": "http://127.0.0.1:3002",
  "statusPublish": {
    "attempts": 6,
    "waitMs": 5000,
    "timeoutMs": 10000
  },
  "restoreRoot": "/srv/scratch",
  "remoteSqlite": {
    "machine": "aico",
    "source": "pve-ct-190-aico-data",
    "snapshotCommand": [
      "ssh",
      "-o",
      "BatchMode=yes",
      "proxmox-gem",
      "pct",
      "exec",
      "190",
      "--",
      "systemctl",
      "--user",
      "--machine=kasadis@.host",
      "start",
      "aico-state-snapshot.service"
    ],
    "timeCommand": [
      "ssh",
      "-o",
      "BatchMode=yes",
      "proxmox-gem",
      "pct",
      "exec",
      "190",
      "--",
      "stat",
      "-c",
      "%Y",
      "/home/kasadis/.local/state/aico-snapshot/notes.db"
    ]
  },
  "sourceProjects": {
    "aico-davion-sidarli": "aico",
    "aico-aico": "aico",
    "pve-ct-190-aico-data": "aico",
    "pve-vm-180-app-recovery": "portfolio-ai",
    "pve-ct-191-jobinator-data": "jobinator-4000",
    "pve-vm-210-dadbot-data": "dadbot",
    "ominull-evidence-replica": "ominull"
  },
  "displayNames": {
    "a-term": "Aico previous app",
    "aico-web-state": "Aico saved web state"
  },
  "appendClients": {
    "aico": {
      "repository": "rclone:aico-ct190:repo",
      "passwordFile": "~/.local/state/aico/secrets/backup-append.password",
      "key": "~/.local/state/aico/secrets/backup-append.ed25519"
    }
  },
  "driveClients": {
    "aico": {
      "repository": "rclone:aico-notes-drive:SummitFlow-Aico-gem-backup",
      "passwordFile": "~/.local/state/aico/secrets/backup-append.password",
      "rcloneConfig": "~/.config/aico-export/notes-drive.conf",
      "pruneQualified": true,
      "guests": [
        "pve-ct-191-jobinator-data",
        "pve-vm-210-dadbot-data",
        "pve-vm-180-app-recovery",
        "pve-cluster-config",
        "ominull-production-state"
      ],
      "stages": {
        "ominull-production-state": {
          "path": "~/.local/state/aico/standby-stage/ominull-production-state/current",
          "env": { "OMINULL_BACKUP_STAGE": "~/.local/state/aico/standby-stage" }
        }
      }
    }
  },
  "externalProbes": {
    "blackbox-archive": {
      "path": "/media/kasadis/Backups/blackbox"
    },
    "portfolio-ai-complete": {
      "command": [
        "ssh",
        "-o",
        "BatchMode=yes",
        "proxmox-gem",
        "qm",
        "guest",
        "exec",
        "180",
        "--",
        "/usr/bin/find",
        "/var/lib/app-backups",
        "-maxdepth",
        "2",
        "-type",
        "f",
        "-printf",
        "%T@,"
      ],
      "jsonGuest": true,
      "statusCommand": ["ssh", "-o", "BatchMode=yes", "proxmox-gem", "qm", "status", "180"]
    },
    "jobinator-snapshot": {
      "command": [
        "ssh",
        "-o",
        "BatchMode=yes",
        "proxmox-gem",
        "pct",
        "exec",
        "191",
        "--",
        "/usr/bin/find",
        "/var/lib/jobinator/snapshot",
        "-maxdepth",
        "1",
        "-type",
        "f",
        "-name",
        "jobinator.db",
        "-printf",
        "%T@,"
      ],
      "statusCommand": ["ssh", "-o", "BatchMode=yes", "proxmox-gem", "pct", "status", "191"]
    }
  },
  "packageStatusPath": "/var/lib/dpkg/status",
  "bootPaths": ["/", "/boot", "/boot/efi"],
  "runProperties": [
    "Nice=19",
    "IOSchedulingClass=idle",
    "CPUWeight=10",
    "MemoryHigh=3G",
    "MemoryMax=6G",
    "KillSignal=SIGINT",
    "TimeoutStopSec=90"
  ],
  "verify": {
    "day": 0,
    "at": "05:00",
    "sample": "500M",
    "maxUnused": "10%",
    "maxRepack": "2G"
  },
  "workSnapshotDisposable": [
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    ".next",
    ".pytest_cache",
    ".ruff_cache",
    ".mypy_cache",
    ".dev-tools",
    ".turbo"
  ],
  "workSnapshotDeleteHelper": "/usr/local/sbin/summitflow-snapshot-delete"
}
