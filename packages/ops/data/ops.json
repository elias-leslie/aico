{
  "deploy": {
    "releasesDir": "~/.local/lib/aico/releases",
    "jobsDir": "~/.local/state/aico/deploys",
    "keepReleases": 3,
    "rootSources": ["package.json", "package-lock.json", "tsconfig.base.json", "vendor"],
    "unitSources": {
      "aico-web.service": ["packages/web-frontend"]
    },
    "healthAttempts": 15,
    "jobEnv": [
      "PATH",
      "HOME",
      "XDG_RUNTIME_DIR",
      "AICO_NODE",
      "AICO_SESSION_ID",
      "AICO_AGENT_SLUG",
      "CLAUDE_CODE_SESSION_ID",
      "CLAUDE_SESSION_ID",
      "CODEX_THREAD_ID",
      "CODEX_SESSION_ID",
      "PI_SESSION_ID",
      "ANTIGRAVITY_CONVERSATION_ID",
      "ST_SESSION_ID",
      "TMUX",
      "TMUX_PANE"
    ]
  },
  "vm": {
    "ssh": "root@davion-gem",
    "powerPools": ["summitflow", "summitflow-ops", "summitflow-power"],
    "snapshotPools": ["summitflow"],
    "labRegistry": "/var/lib/nightshift/findings/registry.json",
    "labHours": 4
  },
  "snapshots": {
    "catalogue": "~/.local/share/st/snaps",
    "workspacesRoot": "/srv/workspaces"
  }
}
