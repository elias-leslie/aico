{
  "deploy": {
    "releasesDir": "~/.local/lib/aico/releases",
    "jobsDir": "~/.local/state/aico/deploys",
    "keepReleases": 3,
    "rootSources": ["package.json", "package-lock.json", "tsconfig.base.json", "vendor"],
    "unitSources": {
      "aico-web.service": ["packages/web-frontend"],
      "aico-jobs.service": ["packages/web-server", "packages/checks", "packages/ops"]
    },
    "healthAttempts": 15,
    "jobEnv": [
      "PATH",
      "HOME",
      "XDG_RUNTIME_DIR",
      "AICO_NODE",
      "AICO_SESSION_ID",
      "AICO_AGENT_SLUG",
      "CLAUDE_CODE_SESSION_ID",
      "CLAUDE_SESSION_ID",
      "CODEX_THREAD_ID",
      "CODEX_SESSION_ID",
      "PI_SESSION_ID",
      "ANTIGRAVITY_CONVERSATION_ID",
      "ST_SESSION_ID",
      "TMUX",
      "TMUX_PANE",
      "AICO_DEPLOY_ROOT"
    ],
    "installedOps": "~/.local/lib/aico/ops",
    "cliSources": ["packages", "native/st-sdk", "native/service-tools", "native/host-steward"]
  },
  "vm": {
    "timeoutSeconds": 900,
    "labRegistry": "/var/lib/nightshift/findings/registry.json",
    "labHours": 4,
    "apiUrl": "https://192.168.86.39:8006",
    "node": "davion-gem",
    "caBundle": "/home/kasadis/.config/summitflow/pve-root-ca.pem",
    "login": "proxmox-vm"
  },
  "snapshots": {
    "catalogue": "~/.local/share/st/snaps",
    "workspacesRoot": "/srv/workspaces"
  }
}
