{
  "deploy": {
    "releasesDir": "~/.local/lib/aico/releases",
    "jobsDir": "~/.local/state/aico/deploys",
    "keepReleases": 3,
    "rootSources": ["package.json", "package-lock.json", "tsconfig.base.json", "vendor"],
    "unitSources": {
      "aico-web.service": ["packages/web-frontend"],
      "aico-jobs.service": [
        "packages/web-server",
        "packages/checks",
        "packages/ops",
        "packages/video"
      ]
    },
    "frontends": {
      "aico-web.service": {
        "package": "web-frontend",
        "out": "out",
        "link": "~/.local/lib/aico/web",
        "keep": 2
      }
    },
    "healthAttempts": 15,
    "jobEnv": [
      "PATH",
      "HOME",
      "XDG_RUNTIME_DIR",
      "AICO_NODE",
      "AICO_SESSION_ID",
      "AICO_AGENT_SLUG",
      "CLAUDE_CODE_SESSION_ID",
      "CLAUDE_SESSION_ID",
      "CODEX_THREAD_ID",
      "CODEX_SESSION_ID",
      "PI_SESSION_ID",
      "ANTIGRAVITY_CONVERSATION_ID",
      "ST_SESSION_ID",
      "TMUX",
      "TMUX_PANE",
      "AICO_DEPLOY_ROOT"
    ],
    "installedOps": "~/.local/lib/aico/ops",
    "cliSources": ["packages", "native/st-sdk", "native/service-tools", "native/host-steward"],
    "rootInstall": {
      "sources": ["native/host-steward"],
      "installer": "/usr/local/lib/host-steward/install-signed.py",
      "receipt": "/usr/local/lib/host-steward/installed.json",
      "signingKey": "update-signing-key",
      "declareWhat": "any"
    },
    "hookInstall": {
      "source": "native/hook",
      "dir": "~/.local/lib/aico/hook"
    }
  },
  "vm": {
    "timeoutSeconds": 900,
    "labHours": 4
  },
  "snapshots": {
    "catalogue": "~/.local/share/st/snaps",
    "workspacesRoot": "/srv/workspaces"
  },
  "plug": {
    "timeoutSeconds": 5,
    "cycleSeconds": 10,
    "plugs": [
      {
        "name": "shed",
        "address": "192.168.87.217",
        "port": 9999,
        "sockets": [
          { "machine": "davion-sidarli", "hostnames": ["davion-sidarli"] },
          { "machine": "davion-gem", "hostnames": ["davion-gem", "aico"] }
        ]
      },
      {
        "name": "shed-network",
        "address": "192.168.87.193",
        "port": 9999,
        "sockets": [{ "machine": null, "label": "shed network" }, { "machine": null }]
      }
    ]
  },
  "power": {
    "answerSeconds": 3,
    "peerSeconds": 6,
    "hosts": {
      "davion-sidarli": {
        "address": "192.168.86.128",
        "port": 22,
        "ssh": "workstation",
        "wake": { "mac": "10:ff:e0:35:51:f1", "broadcast": "192.168.86.255", "port": 9 },
        "shutdown": ["systemctl", "poweroff", "--no-ask-password"],
        "prepareSeconds": 120
      }
    },
    "units": [
      { "unit": "aico-web.service", "label": "Aico", "scope": "user", "reloadsPage": true },
      { "unit": "aico-jobs.service", "label": "Routines", "scope": "user" },
      { "unit": "tether@default.service", "label": "Sessions", "scope": "user" },
      {
        "unit": "cloudflared-aico.service",
        "label": "Aico address",
        "scope": "system",
        "reloadsPage": true
      },
      {
        "unit": "cloudflared.service",
        "label": "Other addresses",
        "scope": "system",
        "machines": ["davion-sidarli"]
      }
    ]
  },
  "away": {
    "enabled": false,
    "countdownSeconds": 120,
    "settleSeconds": 120,
    "statusUrl": "http://127.0.0.1:3002",
    "peers": ["aico-gem"],
    "hosts": {
      "davion-gem": {
        "countdownSeconds": 300,
        "coversGuests": true,
        "shutdown": {
          "ssh": "davion-gem",
          "command": ["systemctl", "poweroff", "--no-ask-password"]
        }
      },
      "davion-sidarli": {
        "shutdown": { "sudo": true, "command": ["systemctl", "poweroff", "--no-ask-password"] }
      }
    }
  }
}
