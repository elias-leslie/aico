{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "root": false,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "app/**",
      "components/**",
      "lib/**",
      "hooks/**",
      "*.ts",
      "*.tsx",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "correctness": {},
      "complexity": {
        "noImportantStyles": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "useButtonType": "off",
        "noStaticElementInteractions": "off",
        "noLabelWithoutControl": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off",
        "useAriaPropsSupportedByRole": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!**/*.test.*",
        "!**/*.config.*",
        "!**/scripts/**",
        "!**/test-stubs/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "paths": {
                  "node:sqlite": "Only the store package imports node:sqlite."
                },
                "patterns": [
                  {
                    "group": [
                      "@aico/agent",
                      "@aico/agent/**",
                      "@aico/checks",
                      "@aico/checks/**",
                      "@aico/context",
                      "@aico/context/**",
                      "@aico/fleet",
                      "@aico/fleet/**",
                      "@aico/jobs",
                      "@aico/jobs/**",
                      "@aico/notes",
                      "@aico/notes/**",
                      "@aico/notify",
                      "@aico/notify/**",
                      "@aico/shared",
                      "@aico/shared/**",
                      "@aico/status",
                      "@aico/status/**",
                      "@aico/store",
                      "@aico/store/**",
                      "@aico/tasks",
                      "@aico/tasks/**",
                      "@aico/tether",
                      "@aico/tether/**",
                      "@aico/tether-client",
                      "@aico/tether-client/**",
                      "@aico/usage",
                      "@aico/usage/**",
                      "@aico/web-server",
                      "@aico/web-server/**",
                      "@aico/webtools",
                      "@aico/webtools/**"
                    ],
                    "message": "@aico/web-frontend (layer 6): import only @aico/ui-kit (package.json aico.imports; depcruise is the gate)"
                  },
                  {
                    "group": [
                      "node:*"
                    ],
                    "message": "@aico/web-frontend (layer 6): browser code has no node:* modules"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
