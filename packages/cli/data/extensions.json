      "owner": "vault-tools",
      "namespace": "wiki",
      "manifest": "extensions/wiki.json",
      "executable": ".venv/bin/vault-st",
      "grant": {
        "enabled": true,
        "effects": ["read-local", "write-local"]
      },
      "environment": ["ST_VAULT_ROOT"]
    },
