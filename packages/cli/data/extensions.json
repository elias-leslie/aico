{
  "contractVersion": 1,
  "bindings": [
    {
      "id": "agent-hub.agents",
      "owner": "agent-hub",
      "namespace": "agents",
      "manifest": "extensions/agents.json",
      "executable": "backend/.venv/bin/agent-hub-st",
      "arguments": ["agents"],
      "grant": {
        "enabled": true,
        "effects": [
          "network",
          "read-remote",
          "write-remote",
          "read-local",
          "write-local",
          "credentials"
        ]
      },
      "environment": [],
      "execution_source": "accepted_runtime",
      "owner_manifest": "st-extensions/agents.json"
    },
    {
      "id": "bugout.recon",
      "owner": "bugout",
      "namespace": "bugout",
      "manifest": "extensions/bugout-recon.json",
      "owner_manifest": "operators/recon/st-extension.json",
      "executable": "operators/recon/bugout",
      "execution_source": "checkout",
      "grant": {
        "enabled": true,
        "effects": ["read-local", "write-local", "network", "process"]
      },
      "arguments": [],
      "environment": [],
      "owner_help": true
    },
    {
      "id": "bugout.deployment",
      "owner": "bugout",
      "namespace": "bugout-deployment",
      "manifest": "extensions/bugout-observer.json",
      "owner_manifest": "operators/recon/st-observer-extension.json",
      "executable": "operators/recon/observe_deployment",
      "execution_source": "checkout",
      "grant": {
        "enabled": true,
        "effects": ["network", "read-remote", "read-local", "credentials", "process"]
      },
      "arguments": [],
      "environment": []
    },
    {
      "id": "jobinator-4000.jobs",
      "owner": "jobinator-4000",
      "namespace": "jobs",
      "manifest": "extensions/jobs.json",
      "executable": "backend/.venv/bin/jobinator-st",
      "grant": {
        "enabled": true,
        "effects": ["network", "read-remote", "write-remote", "credentials"]
      },
      "environment": ["ST_JOBS_API_URL", "ST_API_BASE"]
    },
    {
      "id": "neri.neri",
      "owner": "neri",
      "namespace": "neri",
      "manifest": "extensions/neri.json",
      "owner_manifest": "st-extension.json",
      "executable": "backend/.venv/bin/neri-st",
      "grant": {
        "enabled": true,
        "effects": ["read-local", "write-local", "process"]
      },
      "environment": [
        "NERI_DB_URL",
        "NERI_HUNTERS_ROOT",
        "NERI_HUNTER_GRANTS",
        "NERI_HUNT_STATE",
        "NERI_HUNTS_POLICY",
        "NERI_PROXY_CONFIG",
        "NERI_PROXY_STATE",
        "NERI_HUNTER_URL",
        "NERI_PORT",
        "TETHER_SOCKET",
        "TETHER_INSTANCE",
        "TETHER_HOSTS_FILE",
        "TETHER_PLACEMENT_FILE",
        "XDG_RUNTIME_DIR",
        "DBUS_SESSION_BUS_ADDRESS"
      ]
    },
    {
      "id": "portfolio-ai.portfolio",
      "owner": "portfolio-ai",
      "namespace": "portfolio",
      "manifest": "extensions/portfolio.json",
      "executable": "backend/.venv/bin/portfolio-st",
      "grant": {
        "enabled": true,
        "effects": ["network", "read-remote", "write-remote", "credentials"]
      },
      "environment": ["ST_PORTFOLIO_API_URL", "ST_API_BASE"]
    },
    {
      "id": "desktop-automation.ui",
      "owner": "desktop-automation",
      "namespace": "ui",
      "manifest": "extensions/ui.json",
      "executable": ".venv/bin/desktop-st-ui",
      "grant": {
        "enabled": true,
        "effects": ["desktop", "read-local", "write-local", "process"]
      },
      "environment": [
        "DISPLAY",
        "XAUTHORITY",
        "ST_UI_DISPLAY",
        "ST_UI_XAUTHORITY",
        "XDG_RUNTIME_DIR",
        "WAYLAND_DISPLAY",
        "DBUS_SESSION_BUS_ADDRESS"
