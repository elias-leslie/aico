{
  "name": "@aico/cli",
  "version": "0.1.0",
  "description": "The st and aico CLI shell over Aico and standalone versioned extensions.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "aico": {
    "layer": 5,
    "imports": [
      "@aico/shared",
      "@aico/store",
      "@aico/tasks",
      "@aico/tether-client"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --log-level=error --outfile=dist/aico-cli.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aico/shared": "0.1.0",
    "@aico/store": "0.1.0",
    "@aico/tasks": "0.1.0",
    "@aico/tether-client": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
