#!/usr/bin/env bash
# `aico memory | prompt | models | context`: context.db (memories, prompts, roles, launch options).
# `aico usage`: usage.db (what each subscription has left; packages/usage).
# `aico jobs`: the scheduler's jobs (packages/jobs, jobs.db).
# `aico sessions`: the session history, from the running Tether (`tether history`).
# `aico lease`, `aico sessions send|ack|confirm|inbox`: file leases and the agent handshakes (aico-hook).
# `aico pulse`: live sessions, claims, leases, open handshakes and Status problems; --brief is the startup brief.
# `aico tasks | projects`: tasks.db (light tasks, claims, the projects registry; packages/tasks).
# `aico agent run`: Aico's own agent harness (packages/agent, agent.db).
# `aico check | commit`, `aico tasks done`: the repo gate, path-scoped commits and closeout (packages/checks).
# `aico deploy | logs | snapshots | vm`: deploys, unit logs, Btrfs points and Proxmox guests (packages/ops).
# `aico web search|research|fetch|batch|refocus`: public web search and fetch with a call counter (packages/webtools).
# `aico ask MODEL "question"`: one question to one model, no tools (packages/agent).
# Only those commands: anything else (or nothing) prints the usage and exits 2, so this
# never starts the web server.
set -euo pipefail

# The coordination verbs run in the hook binary (one store, one implementation).
aico_hook_bin() { command -v aico-hook || echo "$HOME/.local/bin/aico-hook"; }

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/aico-web.sh"

# The checks bundle; rebuilt when its sources (or the packages it bundles) are newer.
aico_checks() {
  local checks_dir="$AICO_REPO_ROOT/packages/checks" node
  local checks_bundle="$checks_dir/dist/aico-checks.mjs"
  node="$(aico_web_node)"
  if [ ! -r "$checks_bundle" ] || [ -n "$(find "$checks_dir/src" "$checks_dir/data" "$AICO_REPO_ROOT/packages/tasks/src" "$AICO_REPO_ROOT/packages/tasks/data" \
    "$AICO_REPO_ROOT/packages/tether-client/src" "$AICO_REPO_ROOT/packages/status/src" "$AICO_REPO_ROOT/packages/store/src" \
    \( -name '*.ts' -o -name '*.json' \) -newer "$checks_bundle" -print -quit 2>/dev/null)" ]; then
    PATH="$(dirname "$node"):$PATH" npm --prefix "$checks_dir" run --silent build >&2
  fi
  case "$*" in
    'check --help' | 'check -h' | 'commit --help' | 'commit -h' | 'tasks done --help')
      exec "$node" --disable-warning=ExperimentalWarning "$checks_bundle" "$@" ;;
  esac
  # Publication selection and Status are light. The retained outgoing verifier
  # takes shared admission only while it scans, not while GitHub is answering.
  [ "${1:-}" != publish ] || exec "$node" --disable-warning=ExperimentalWarning "$checks_bundle" "$@"
  exec st tools run --label "aico ${1:-checks}" -- "$node" --disable-warning=ExperimentalWarning "$checks_bundle" "$@"
}

[ "${1:-}" = tasks ] && [ "${2:-}" = done ] && aico_checks "$@"

# Ops runs from the installed release. A first install builds an export of HEAD, never dirty sources.
aico_ops() {
  local node sha installed ops_bundle bootstrap
  node="$(aico_web_node)"
  sha="$(git -C "$AICO_REPO_ROOT" rev-parse HEAD)"
  installed="${AICO_OPS_INSTALLED:-$(git -C "$AICO_REPO_ROOT" show "$sha:packages/ops/data/ops.json" | \
    "$node" -e 'let s="";process.stdin.on("data",x=>s+=x).on("end",()=>console.log(JSON.parse(s).deploy.installedOps.replace(/^~(?=\/)/,process.env.HOME)))')}"
  ops_bundle="$installed/packages/ops/dist/aico-ops.mjs"
  if [ ! -r "$ops_bundle" ]; then
    bootstrap="$installed.bootstrap"
    mkdir -p "$bootstrap"
    (
      flock 9
      [ ! -r "$ops_bundle" ] || exit 0
      [ ! -r "$bootstrap/$sha/packages/ops/dist/aico-ops.mjs" ] || exit 0
      local staging
      staging="$(mktemp -d "$bootstrap/.$sha.XXXXXX")"
      trap 'rm -rf -- "$staging"' EXIT
      git -C "$AICO_REPO_ROOT" archive "$sha" | tar -x -C "$staging"
      cd "$staging"
      PATH="$(dirname "$node"):$PATH" st tools run --label 'Build committed Aico ops' -- bash -c \
        'npm ci --no-audit --no-fund --prefer-offline && npm run --silent build -w packages/ops' >&2
      mv -- "$staging" "$bootstrap/$sha"
    ) 9>"$bootstrap/build.lock"
    [ -r "$ops_bundle" ] || ops_bundle="$bootstrap/$sha/packages/ops/dist/aico-ops.mjs"
  fi
  # Pin the real file: a detached job keeps this version even when another deploy moves the link.
  ops_bundle="$(readlink -f -- "$ops_bundle")"
  AICO_REPO_ROOT="$AICO_REPO_ROOT" exec "$node" --disable-warning=ExperimentalWarning "$ops_bundle" "$@"
}

# The webtools bundle; rebuilt when its sources (or the packages it bundles) are newer.
aico_webtools() {
  local web_dir="$AICO_REPO_ROOT/packages/webtools" node
  local web_bundle="$web_dir/dist/aico-webtools.mjs"
  node="$(aico_web_node)"
  if [ ! -r "$web_bundle" ] || [ -n "$(find "$web_dir/src" "$AICO_REPO_ROOT/packages/status/src" \
    "$AICO_REPO_ROOT/packages/store/src" -name '*.ts' -newer "$web_bundle" -print -quit 2>/dev/null)" ]; then
    PATH="$(dirname "$node"):$PATH" npm --prefix "$web_dir" run --silent build >&2
  fi
  AICO_REPO_ROOT="$AICO_REPO_ROOT" exec "$node" --disable-warning=ExperimentalWarning "$web_bundle" "$@"
}

case "${1:-}" in
  memory | prompt | models | context | usage) exec_aico_web "$@" ;;
  check | commit | publish) aico_checks "$@" ;;
  deploy | logs | snapshots | vm) aico_ops "$@" ;;
  web) shift; aico_webtools "$@" ;;
  jobs)
    shift
    jobs_dir="$AICO_REPO_ROOT/packages/jobs"
    jobs_bundle="$jobs_dir/dist/aico-jobs.mjs"
    node="$(aico_web_node)"
    if [ ! -r "$jobs_bundle" ] || [ -n "$(find "$jobs_dir/src" "$AICO_REPO_ROOT/packages/status/src" \
      "$AICO_REPO_ROOT/packages/store/src" -name '*.ts' -newer "$jobs_bundle" -print -quit 2>/dev/null)" ]; then
      PATH="$(dirname "$node"):$PATH" npm --prefix "$jobs_dir" run --silent build >&2
    fi
    exec "$node" --disable-warning=ExperimentalWarning "$jobs_bundle" "$@"
    ;;
  tasks | projects | pulse)
    tasks_dir="$AICO_REPO_ROOT/packages/tasks"
    tasks_bundle="$tasks_dir/dist/aico-tasks.mjs"
    node="$(aico_web_node)"
    if [ ! -r "$tasks_bundle" ] || [ -n "$(find "$tasks_dir/src" "$tasks_dir/data" "$AICO_REPO_ROOT/packages/tether-client/src" \
      "$AICO_REPO_ROOT/packages/status/src" "$AICO_REPO_ROOT/packages/store/src" \( -name '*.ts' -o -name '*.json' \) -newer "$tasks_bundle" -print -quit 2>/dev/null)" ]; then
      PATH="$(dirname "$node"):$PATH" npm --prefix "$tasks_dir" run --silent build >&2
    fi
    exec "$node" --disable-warning=ExperimentalWarning "$tasks_bundle" "$@"
    ;;
  agent | ask)
    [ "$1" = agent ] && shift
    agent_dir="$AICO_REPO_ROOT/packages/agent"
    agent_bundle="$agent_dir/dist/aico-agent.mjs"
    node="$(aico_web_node)"
    if [ ! -r "$agent_bundle" ] || [ -n "$(find "$agent_dir/src" "$agent_dir/data" "$AICO_REPO_ROOT/packages/context/src" "$AICO_REPO_ROOT/packages/tether-client/src" \
      "$AICO_REPO_ROOT/packages/context/data" "$AICO_REPO_ROOT/packages/store/src" \( -name '*.ts' -o -name '*.json' \) \
      -newer "$agent_bundle" -print -quit 2>/dev/null)" ]; then
      PATH="$(dirname "$node"):$PATH" npm --prefix "$agent_dir" run --silent build >&2
    fi
    exec "$node" --disable-warning=ExperimentalWarning "$agent_bundle" "$@"
    ;;
  lease)
    shift
    exec "$(aico_hook_bin)" lease "$@"
    ;;
  sessions)
    shift
    case "${1:-}" in
      send | ack | confirm | inbox) exec "$(aico_hook_bin)" sessions "$@" ;;
      *) exec tether history "$@" ;;
    esac
    ;;
  help | -h | --help) exec_aico_web memory --help ;;
  *)
    [ $# -gt 0 ] && echo "aico: unknown command '$1'" >&2
    echo "Usage: aico <memory|prompt|models|context|usage|jobs|tasks|projects|pulse|lease|agent|sessions|check|commit|deploy|logs|snapshots|vm|web|ask> ...  (aico help lists every command)" >&2
    exit 2
    ;;
esac
